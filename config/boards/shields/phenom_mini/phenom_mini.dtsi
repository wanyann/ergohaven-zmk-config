#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_strip;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <10>;
        map = <
            RC(1,5)  RC(1,4)  RC(1,3)  RC(1,2)  RC(1,1)  RC(1,0)                       RC(6,0)  RC(6,1)  RC(6,2)  RC(6,3)  RC(6,4)  RC(6,5)
            RC(2,5)  RC(2,4)  RC(2,3)  RC(2,2)  RC(2,1)  RC(2,0)                       RC(7,0)  RC(7,1)  RC(7,2)  RC(7,3)  RC(7,4)  RC(7,5)
            RC(3,5)  RC(3,4)  RC(3,3)  RC(3,2)  RC(3,1)  RC(3,0)                       RC(8,0)  RC(8,1)  RC(8,2)  RC(8,3)  RC(8,4)  RC(8,5)
                              RC(4,3)  RC(4,2)  RC(2,7)  RC(1,7)  RC(0,7)     RC(5,7)  RC(6,7)  RC(7,7)  RC(9,2)  RC(9,3)
                              RC(4,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        // Строки: GP6, GP5, GP4, GP3, GP2
        row-gpios
            = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        // Колонки: GP7, GP12, GP13, GP14, GP15, GP16, GP17, GP18
        col-gpios
            = <&gpio0 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 12 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 16 GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 18 GPIO_ACTIVE_HIGH>
            ;
    };

    // Энкодер на левой половине: A=GP24, B=GP23
    encoder: encoder {
        compatible = "alps,ec11";
        label = "ENCODER";
        a-gpios = <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <8>;
    };

    /* led_strip определён ниже через &pio0 (PIO SPI + worldsemi,ws2812-spi),
     * DIN = GP25. label и chosen живут в одном parse-юните с overlay-ами,
     * поэтому led_strip не выносится в отдельный boards/rpi_pico.overlay. */

    // Листенер трекбола живёт только на центральной (левой) половине,
    // принимает события от proxy-устройства zmk,input-split.
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
            device = <&trackball>;
        };
    };

    wired_split: wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };
// Трекбол PMW3610 только на правой половине. Распайка повторяет проверенную
    // QMK-прошивку: 3-проводной бит-банг SPI SCLK=GP10, SDIO=GP11, CS=GP9,
    // без пина IRQ/MOTION (сенсор опрашивается в драйвере ergohaven,pmw3610-gpio).
    trackball: trackball {
        status = "disabled";
        compatible = "ergohaven,pmw3610-gpio";
        sclk-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
        sdio-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
        cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
        cpi = <600>;
        swap-xy;
        invert-x;
        invert-y;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/* USB CDC ACM virtual serial port, used as the logging console when
 * CONFIG_ZMK_USB_LOGGING=y (mirrors the zmk-usb-logging snippet).
 * The TX ring buffer is sized by CONFIG_USB_CDC_ACM_RINGBUF_SIZE
 * (set in phenom_mini.conf), not by this node's tx-fifo-size property. */
&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
    };
};

&pinctrl {
    pio0_spi0_default: pio0_spi0_default {
        group1 {
            /* MOSI (LED DIN) = GP25, CLK = GP20 (свободный на обеих половинах) */
            pinmux = <PIO0_P25>, <PIO0_P20>;
        };
        group2 {
            /* MISO: переиспользуем DIN — OK для WS2812 (master-only, ответ не читается) */
            pinmux = <PIO0_P25>;
            input-enable;
        };
    };
};

&pio0 {
    status = "okay";

    pio0_spi0: pio0_spi0 {
        pinctrl-0 = <&pio0_spi0_default>;
        pinctrl-names = "default";
        compatible = "raspberrypi,pico-spi-pio";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;
        clocks = <&system_clk>;
        clk-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        mosi-gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
        miso-gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>; /* reuse DI — OK per ZMK docs */

        led_strip: ws2812@0 {
            compatible = "worldsemi,ws2812-spi";
            reg = <0>;
            spi-max-frequency = <4000000>;
            spi-one-frame = <0x70>;
            spi-zero-frame = <0x40>;
            chain-length = <1>;
            color-mapping = <LED_COLOR_ID_GREEN
                             LED_COLOR_ID_RED
                             LED_COLOR_ID_BLUE>;
        };
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
};