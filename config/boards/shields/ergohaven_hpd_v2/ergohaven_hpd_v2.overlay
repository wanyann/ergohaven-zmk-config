#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    // === 1. Конфигурация локальной матрицы 5x6 ===
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        
        // Строки: GP6, GP5, GP4, GP3, GP2 (из вашего config.h)
        row-gpios 
            = <&gpio0 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 5 GPIO_ACTIVE_HIGH>
            , <&gpio0 4 GPIO_ACTIVE_HIGH>
            , <&gpio0 3 GPIO_ACTIVE_HIGH>
            , <&gpio0 2 GPIO_ACTIVE_HIGH>
            ;
            
        // Колонки: GP7, GP12, GP13, GP14, GP15, GP28 (из вашего config.h)
        col-gpios 
            = <&gpio0 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 12 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            ;
    };

    // === 2. Явное объявление проводного сплита (требование документации ZMK) ===
    wired_split: wired_split {
        compatible = "zmk,wired-split";
        uart = <&uart0>;
    };
};

// === 3. Настройка UART0 для связи (GP0=TX, GP1=RX) ===
&uart0 {
    status = "okay";
    current-speed = <1000000>; // 1 Mbps (стандартная скорость для ZMK split)
    
    // Явно задаем пины для RP2040, чтобы соответствовать вашему config.h
    // GP0 - это UART0 TX, GP1 - это UART0 RX
    pinctrl-0 = <&uart0_default>;
    pinctrl-names = "default";
};

// Описываем пины для UART0 (стандартная нода для RP2040 в Zephyr)
&pinctrl {
    uart0_default: uart0_default {
        group1 {
            pinmux = <PINMUX_FUNC(GP0, UART0_TX)>,
                     <PINMUX_FUNC(GP1, UART0_RX)>;
        };
    };
};