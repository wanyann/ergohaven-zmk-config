#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    // === 1. Конфигурация локальной матрицы 5x6 ===
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        
        // Строки: GP6, GP5, GP4, GP3, GP2 (из вашего config.h)
        row-gpios 
            = <&gpio0 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 5 GPIO_ACTIVE_HIGH>
            , <&gpio0 4 GPIO_ACTIVE_HIGH>
            , <&gpio0 3 GPIO_ACTIVE_HIGH>
            , <&gpio0 2 GPIO_ACTIVE_HIGH>
            ;
            
        // Колонки: GP7, GP12, GP13, GP14, GP15, GP28 (из вашего config.h)
        col-gpios 
            = <&gpio0 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 12 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            ;
    };

    // === 2. Явное объявление проводного сплита (требование документации ZMK) ===
    wired_split: wired_split {
        compatible = "zmk,wired-split";
        uart = <&uart0>;
    };
};

// === 3. Настройка UART0 для связи ===
// Плата rpi_pico уже знает, что uart0 использует GP0 (TX) и GP1 (RX).
// Нам нужно только включить его и задать скорость.
&uart0 {
    status = "okay";
    current-speed = <1000000>; // 1 Mbps (стандарт для ZMK wired split)
};