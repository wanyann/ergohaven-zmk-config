        Sym_Ru {
            bindings = <
&trans  &trans  &none                 &none   &none        &trans                      &trans         &en_kp LEFT_BRACKET  &kp RU_RUBLE  &en_kp RIGHT_BRACKET  &trans  &trans
&trans  &trans  &kp LEFT_PARENTHESIS  &none   &kp RPAR     &kp PLUS                    &kp RU_NUMERO  &en_kp LEFT_BRACE    &none         &en_kp RIGHT_BRACE    &trans  &trans
&trans  &trans  &en_kp TILDE          &none   &kp PERCENT  &ru_code                    &trans         &en_kp LESS_THAN     &en_kp CARET  &en_kp GREATER_THAN   &trans  &trans
                &trans                &trans  &trans       &trans    &trans    &trans  &trans         &trans               &trans        &trans
            >;

            display-name = "Symbols";
