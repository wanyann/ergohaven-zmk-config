    keymap {
        compatible = "zmk,keymap";

        En {
            bindings = <
&kp BACKSPACE  &kp Q                     &kp W                     &kp U                  &mt LC(R) A             &mt LC(T) K_CANCEL                         &kp Z     &kp V             &kp K                  &kp D            &kp K_CANCEL          &none
&kp K_CANCEL   &hrml_slow_en LEFT_GUI C  &hrml_slow_en LEFT_ALT I  &hrosm_l LEFT_SHIFT E  &hrml_en LCTRL O        &en_com_mt LC(F) 0                         &kp L     &hrml_en RCTRL N  &hrosm_r LEFT_SHIFT T  &hrosm_r RALT S  &hrml_slow_en RGUI H  &kp K_CANCEL
&kp DELETE     &mt LC(Z) F               &mt LC(X) Y               &mt LC(C) X            &mt LC(V) SINGLE_QUOTE  &en_dot_mt LG(V) 0                         &kp B     &kp M             &kp P                  &kp G            &mt LC(SLASH) J       &none
                                         &kp LS(F7)                &kp F7                 &ms_over_en             &lt 18 SPACE        &sl 22    &bspc_morph  &lt 20 R  &ms_free_en       &kp F2                 &kp LS(F2)
            >;

            display-name = "English";
        };

        En_CW {
            bindings = <
&trans            &kp LS(Q)                     &kp LS(W)                     &kp LS(U)                  &mt LC(R) LS(A)         &mt LC(T) K_CANCEL                        &kp LS(Z)     &kp LS(V)             &kp LS(K)                  &kp LS(D)            &kp LS(K_CANCEL)          &trans
&kp LS(K_CANCEL)  &hrml_slow_en LEFT_GUI LS(C)  &hrml_slow_en LEFT_ALT LS(I)  &hrosm_l LEFT_SHIFT LS(E)  &hrml_en LCTRL LS(O)    &en_com_mt LC(F) 0                        &kp LS(L)     &hrml_en RCTRL LS(N)  &hrosm_r LEFT_SHIFT LS(T)  &hrosm_r RALT LS(S)  &hrml_slow_en RGUI LS(H)  &kp LS(K_CANCEL)
&trans            &mt LC(Z) LS(F)               &mt LC(X) LS(Y)               &mt LC(C) LS(X)            &mt LC(V) SINGLE_QUOTE  &en_dot_mt LG(V) 0                        &kp LS(B)     &kp LS(M)             &kp LS(P)                  &kp LS(G)            &mt LC(SLASH) LS(J)       &trans
                                                &trans                        &trans                     &ms_over_en             &en_lt_cw_off 18 SPACE  &sl 22    &trans  &lt 20 LS(R)  &ms_free_en           &trans                     &trans
            >;

