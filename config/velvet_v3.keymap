        M1 {
            bindings = <
&trans                &kp_m1 RU_CYRILLIC_TSE      &kp_m1 RU_CYRILLIC_SOFT_SIGN  &kp_m1 RU_CYRILLIC_YA  &kp_m1 RU_CYRILLIC_A     &kp_m1 RU_CYRILLIC_YU                                        &kp RU_CYRILLIC_ZE  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_DE   &kp RU_CYRILLIC_SHCHA  &trans
&kp_m1 RU_CYRILLIC_E  &kp_m1 RU_CYRILLIC_SHORT_I  &kp_m1 RU_CYRILLIC_I          &kp_m1 RU_CYRILLIC_IE  &kp_m1 RU_CYRILLIC_O     &kp_m1 LS(N6)                                                &kp RU_CYRILLIC_EL  &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_ES   &kp RU_CYRILLIC_CHE    &kp RU_CYRILLIC_SHA
&trans                &kp_m1 RU_CYRILLIC_EF       &kp_m1 RU_CYRILLIC_U          &kp_m1 RU_CYRILLIC_HA  &kp_m1 RU_CYRILLIC_YERU  &kp_m1 LS(RU_N7)                                             &kp RU_CYRILLIC_BE  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_PE  &kp RU_CYRILLIC_GHE  &kp RU_CYRILLIC_ZHE    &trans
                                                  &trans                        &trans                 &overoff_ru              &nav_set 10 4          &overoff_sl 6 14    &switch_mon BSPC  &back_num 12 8      &overoff_en         &trans              &trans
            >;
        };

        M2 {
            bindings = <
&trans             &kp RU_CYRILLIC_TSE      &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_YA  &kp RU_CYRILLIC_A     &kp RU_CYRILLIC_YU                                             &kp_m2 RU_CYRILLIC_ZE  &kp_m2 RU_CYRILLIC_VE  &kp_m2 RU_CYRILLIC_KA  &kp_m2 RU_CYRILLIC_DE   &kp_m2 RU_CYRILLIC_SHCHA  &trans
&kp RU_CYRILLIC_E  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_I          &kp RU_CYRILLIC_IE  &kp RU_CYRILLIC_O     &kp LS(N6)                                                     &kp_m2 RU_CYRILLIC_EL  &kp_m2 RU_CYRILLIC_EN  &kp_m2 RU_CYRILLIC_TE  &kp_m2 RU_CYRILLIC_ES   &kp_m2 RU_CYRILLIC_CHE    &kp_m2 RU_CYRILLIC_SHA
&trans             &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_U          &kp RU_CYRILLIC_HA  &kp RU_CYRILLIC_YERU  &kp LS(RU_N7)                                                  &kp_m2 RU_CYRILLIC_BE  &kp_m2 RU_CYRILLIC_EM  &kp_m2 RU_CYRILLIC_PE  &kp_m2 RU_CYRILLIC_GHE  &kp_m2 RU_CYRILLIC_ZHE    &trans
                                            &trans                     &trans              &overoff_ru           &nav_set 10 4       &overoff_sl 7 14    &switch_mon BACKSPACE  &back_num 12 8         &overoff_en            &trans                 &trans
            >;
        };

        Mod {
            bindings = <
&trans  &kp Q             &kp W             &moff_kp E         &kp R         &kp T                            &kp Y          &kp U              &kp I              &kp O             &kp P                &trans
&trans  &hrm_slow LGUI A  &hrm_slow LALT S  &hrm LEFT_SHIFT D  &hrm LCTRL F  &kp G                            &kp H          &hrm_slow RCTRL J  &hrm LEFT_SHIFT K  &hrm_slow RALT L  &hrm_slow RGUI SEMI  &trans
&trans  &mmt LC(Z) Z      &mmt LC(X) X      &mmt LC(C) C       &mmt LC(V) V  &kp B                            &kp N          &kp M              &kp COMMA          &kp DOT           &kp SLASH            &trans
                          &trans            &trans             &none         &space_lt 10 0  &trans    &none  &bspc_lt 12 0  &none              &trans             &trans
            >;
        };

        Mod_ru {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Nav {
            bindings = <
&trans  &trans                       &macro_unsafe_en              &kp LC(LS(LA(TAB)))  &kp LS(LC(LA(LG(F1))))    &testops                                  &none          &kp LA(LS(S))  &kp UP     &kp END    &kp DELETE  &trans
&trans  &hrm LEFT_GUI ESC            &hrm LALT ENTER               &kp LSHIFT           &mod_dtap LCTRL LEFT_GUI  &layer_on 1                               &kp K_APP      &kp LEFT       &kp DOWN   &kp RIGHT  &kp END     &trans
&trans  &mmt LC(Z) LC(LEFT_BRACKET)  &mmt LC(X) LC(RIGHT_BRACKET)  &mmt LC(C) LS(F6)    &mmt LC(V) TAB            &mt LG(V) LS(LC(LG(F9)))                  &kp LC(F8)     &kp HOME       &kp PG_DN  &kp PG_UP  &trans      &trans
                                     &trans                        &trans               &trans                    &mo 10                    &none    &none  &bspc_lt 12 0  &none          &trans     &trans
            >;
