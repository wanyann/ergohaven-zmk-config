&kp RU_CYRILLIC_E  &kp RU_CYRILLIC_SHORT_I  &mt_sub_en RU_CYRILLIC_I RU_CYRILLIC_I                  &mt_sub_en RU_CYRILLIC_IE RU_CYRILLIC_IE  &mt_sub_en RU_CYRILLIC_O RU_CYRILLIC_O        &kp RU_COMMA                                     &kp RU_CYRILLIC_EL  &mt_sub_en RU_CYRILLIC_EN RU_CYRILLIC_EN  &mt_sub_en RU_CYRILLIC_TE RU_CYRILLIC_TE  &mt_sub_en RU_CYRILLIC_ES RU_CYRILLIC_ES    &kp RU_CYRILLIC_CHE    &kp RU_CYRILLIC_SHA
&none              &kp RU_CYRILLIC_EF       &mt_sub_en RU_CYRILLIC_U RU_CYRILLIC_U                  &mt_sub_en RU_CYRILLIC_HA RU_CYRILLIC_HA  &mt_sub_en RU_CYRILLIC_YERU RU_CYRILLIC_YERU  &kp RU_DOT                                       &kp RU_CYRILLIC_BE  &mt_sub_en RU_CYRILLIC_EM RU_CYRILLIC_EM  &mt_sub_en RU_CYRILLIC_PE RU_CYRILLIC_PE  &mt_sub_en RU_CYRILLIC_GHE RU_CYRILLIC_GHE  &kp RU_CYRILLIC_ZHE    &trans
                                            &trans                                                  &trans                                    &none                                         &space_nav_to 18 0  &none    &kp_to BACKSPACE 8  &move_num 20 4      &trans                                    &trans                                    &trans
            >;
        };

        Mod {
            display-name = "Mod_en";
            bindings = <
&trans  &kp Q             &kp W             &kp E              &kp R         &kp T                                  &kp Y            &kp U              &kp I              &kp O             &kp P                &trans
&trans  &hrm_slow LGUI A  &hrm_slow LALT S  &hrm LEFT_SHIFT D  &hrm LCTRL F  &kp G                                  &kp H            &hrm_slow RCTRL J  &hrm LEFT_SHIFT K  &hrm_slow RALT L  &hrm_slow RGUI SEMI  &trans
&trans  &kp Z             &kp X             &kp C              &kp V         &kp B                                  &kp N            &kp M              &kp COMMA          &kp DOT           &kp SLASH            &trans
                          &trans            &trans             &trans        &space_lt 18 0  &trans    &bspc_morph  &lt 20 K_CANCEL  &trans             &trans             &trans
            >;
        };

        Mod_ru {
            bindings = <
&trans  &kp Q             &kp W             &kp E              &kp R         &kp T                                  &kp Y            &kp U              &kp I              &kp O             &kp P                &trans
&trans  &hrm_slow LGUI A  &hrm_slow LALT S  &hrm LEFT_SHIFT D  &hrm LCTRL F  &kp G                                  &kp H            &hrm_slow RCTRL J  &hrm LEFT_SHIFT K  &hrm_slow RALT L  &hrm_slow RGUI SEMI  &trans
&trans  &kp Z             &kp X             &kp C              &kp V         &kp B                                  &kp N            &kp M              &kp COMMA          &kp DOT           &kp SLASH            &trans
                          &trans            &trans             &trans        &space_lt 19 0  &trans    &bspc_morph  &lt 21 K_CANCEL  &trans             &trans             &trans
            >;

            display-name = "Mod_ru";
        };

        Nav {
            bindings = <
&trans  &trans                          &macro_unsafe_en                 &kp LC(LS(LA(TAB)))  &kp LS(LC(LA(LG(F1))))    &testops                             &none       &kp HOME  &kp UP     &kp END    &kp DELETE  &trans
&trans  &hrm LEFT_GUI LC(LEFT_BRACKET)  &hrm LALT LC(RIGHT_BRACKET)      &kp LSHFT            &mod_dtap LCTRL LEFT_GUI  &zeros_macro                         &kp K_APP   &kp LEFT  &kp DOWN   &kp RIGHT  &kp END     &trans
&trans  &mt LC(Z) LG(LS(LEFT_BRACKET))  &mt LC(X) LG(LS(RIGHT_BRACKET))  &mt LC(C) LS(F6)     &mt LC(V) LS(LC(LA(V)))   &kp LS(LG(LC(F9)))                   &kp LC(F8)  &kp HOME  &kp PG_DN  &kp PG_UP  &none       &trans
                                        &trans                           &trans               &trans                    &none               &none    &trans  &mo 24      &trans    &trans     &trans
            >;

            display-name = "Nav_en";
        };

        Nav_ru {
            bindings = <
&trans  &trans  &macro_unsafe_ru  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans            &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans            &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans            &trans  &trans  &trans  &trans    &trans  &mo 25  &trans  &trans  &trans
            >;

            display-name = "Nav_ru";
        };

        Num {
            bindings = <
&trans  &kp MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp N9        &kp PLUS                        &trans  &trans     &trans      &trans        &trans        &trans
&trans  &kp N0     &kp N1        &kp N2        &kp NUMBER_3  &morph_en_com                   &trans  &kp LCTRL  &kp LSHIFT  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans  &kp EQUAL  &kp N4        &kp N5        &kp N6        &morph_en_dot                   &trans  &trans     &none       &none         &trans        &trans
                   &trans        &trans        &trans        &lt 24 SPACE   &none    &trans  &trans  &trans     &trans      &trans
            >;

            display-name = "Num_en";
        };

        Num_ru {
            display-name = "Num_ru";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &morph_ru_com                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &morph_ru_dot                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &lt 25 SPACE   &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        App {
            bindings = <
&trans                        &kp LA(LC(LS(P)))                    &vm_en LS(LA(LC(LG(W)))) LS(LA(LC(W)))  &mt LS(LA(LC(LG(E)))) LA(LS(LC(E)))  &mt LS(LA(LC(LG(R)))) LS(LA(LC(R)))  &kp LS(LA(LC(T)))                                             &kp LS(LA(LC(Y)))  &kp LS(LA(LC(U)))  &kp LS(LA(LC(I)))      &kp LS(LA(LC(O)))    &kp LS(LA(LC(P)))          &trans
&kp LS(LA(LC(LEFT_BRACKET)))  &mt LS(LA(LC(LG(A)))) LS(LA(LC(A)))  &mt LS(LA(LC(LG(S)))) LS(LA(LC(S)))     &mt LS(LA(LC(LG(D)))) LC(LA(LS(D)))  &kp LS(LA(LC(F)))                    &mt LS(LA(LC(LG(G)))) LA(LS(LC(G)))                           &kp LS(LA(LC(H)))  &kp LS(LA(LC(J)))  &kp LS(LA(LC(K)))      &kp LS(LA(LC(L)))    &kp LS(LA(LC(SEMICOLON)))  &kp LS(LA(LC(RIGHT_BRACKET)))
&trans                        &mt LS(LC(LA(LG(Z)))) LC(LA(LS(Z)))  &mt LS(LA(LC(LG(X)))) LA(LS(LC(X)))     &kp LS(LA(LC(C)))                    &kp LS(LC(LG(V)))                    &mt LS(LA(LC(LG(B)))) LS(LA(LC(B)))                           &kp LS(LA(LC(N)))  &kp LS(LC(LA(M)))  &kp LS(LA(LC(COMMA)))  &kp LS(LA(LC(DOT)))  &kp LS(LC(LA(SLASH)))      &trans
                                                                   &trans                                  &trans                               &trans                               &none                                &sl 22    &kp LA(ENTER)  &alt_spc_en        &trans             &trans                 &trans
            >;

            display-name = "App_en";
        };

        App_ru {
            bindings = <
&trans  &trans  &vm_ru LS(LA(LC(LG(W)))) LS(LA(LC(W)))  &trans  &trans  &trans                    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                                  &trans  &trans  &trans                    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                                  &trans  &trans  &trans                    &trans       &trans  &trans  &trans  &trans  &trans
                &trans                                  &trans  &trans  &trans  &trans    &trans  &alt_spc_ru  &trans  &trans  &trans
            >;

            display-name = "App_ru";
        };

        Sym {
            bindings = <
&trans  &trans  &none                 &kp AMPERSAND  &kp CARET              &trans                         &trans            &kp LEFT_BRACKET  &kp ASTERISK  &kp RIGHT_BRACKET  &trans  &trans
&trans  &trans  &kp LEFT_PARENTHESIS  &kp AT         &kp RIGHT_PARENTHESIS  &kp PERCENT                    &ru_kp RU_NUMERO  &kp LEFT_BRACE    &kp DOLLAR    &kp RIGHT_BRACE    &trans  &trans
&trans  &trans  &kp TILDE             &kp HASH       &en_code               &none                          &trans            &kp LESS_THAN     &arrow_en     &kp GREATER_THAN   &trans  &trans
                &trans                &trans         &trans                 &trans       &trans    &trans  &trans            &trans            &trans        &trans
            >;

            display-name = "Sym_en";
        };

        Sym_ru {
            bindings = <
&trans  &trans  &none                 &en_kp AMPERSAND  &en_kp CARET  &trans                            &trans         &en_kp LEFT_BRACKET  &kp ASTRK      &en_kp RIGHT_BRACKET  &trans  &trans
&trans  &trans  &kp LEFT_PARENTHESIS  &en_kp AT         &kp RPAR      &kp RU_PERCENT                    &kp RU_NUMERO  &en_kp LEFT_BRACE    &en_kp DOLLAR  &en_kp RIGHT_BRACE    &trans  &trans
&trans  &trans  &en_kp TILDE          &en_kp HASH       &ru_code      &none                             &trans         &en_kp LESS_THAN     &arrow_ru      &en_kp GREATER_THAN   &trans  &trans
                &trans                &trans            &trans        &trans          &trans    &trans  &trans         &trans               &trans         &trans
            >;

            display-name = "Sym_ru";
        };

        Fn {
            display-name = "Fn";
            bindings = <
&trans  &trans   &kp F7  &kp F8  &kp F9  &trans                     &trans  &trans     &trans          &trans    &trans        &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp F12                    &trans  &kp LCTRL  &kp LEFT_SHIFT  &kp LALT  &kp LEFT_GUI  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp F11                    &trans  &trans     &trans          &trans    &trans        &trans
                 &trans  &trans  &trans  &trans   &trans    &trans  &trans  &trans     &trans          &trans
            >;
        };

        OS {
            display-name = "OS_en";
            bindings = <
&trans       &bt_set_en 2  &kp_over_en LA(LC(N1))  &kp_over_en LA(LC(N2))    &kp_over_en LC(LA(NUMBER_3))  &kp_over_en LC(LA(NUMBER_4))                    &trans        &none    &trans  &trans  &bt BT_CLR  &trans
&trans       &bt_set_en 1  &kp LC(RIGHT)           &kp LA(LC(N1))            &kp C_VOLUME_UP               &kp C_BRI_UP                                    &out OUT_BLE  &kp F24  &trans  &trans  &soft_off   &trans
&bootloader  &bt_set_en 0  &none                   &kp LC(LS(LEFT_BRACKET))  &kp C_VOL_DN                  &kp C_BRI_DN                                    &out OUT_USB  &kp F23  &trans  &trans  &trans      &bootloader
                           &trans                  &trans                    &trans                        &trans                        &trans    &trans  &trans        &trans   &trans  &trans
            >;
        };

        OS_ru {
            display-name = "OS_ru";
            bindings = <
&trans  &bt_set_ru 2  &kp_over_ru LA(LC(N1))  &kp_over_ru LA(LC(N2))  &kp_over_ru LC(LA(NUMBER_3))  &kp_over_ru LC(LA(NUMBER_4))                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt_set_ru 1  &trans                  &trans                  &trans                        &trans                                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt_set_ru 0  &trans                  &trans                  &trans                        &trans                                          &trans  &trans  &trans  &trans  &trans  &trans
                      &trans                  &trans                  &trans                        &trans                        &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Slower {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Faster {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        OS {
            if-layers = <2 27>;
            then-layer = <28>;
        };

        Num {
            if-layers = <2 20>;
            then-layer = <21>;
        };

        MFree_Num {
            if-layers = <20 9>;
            then-layer = <21>;
        };

        MFree_OS {
            if-layers = <27 9>;
            then-layer = <28>;
        };

        App {
            if-layers = <2 22>;
            then-layer = <23>;
        };

        MFree_App {
            if-layers = <9 22>;
            then-layer = <23>;
        };

        MOver1_App {
            if-layers = <12 22>;
            then-layer = <23>;
        };

        MOver2_App {
            if-layers = <13 22>;
            then-layer = <23>;
        };

        MOver1_Num {
            if-layers = <12 20>;
            then-layer = <21>;
        };

        MOver2_Num {
            if-layers = <20 13>;
            then-layer = <21>;
        };

        Nav {
            if-layers = <2 18>;
            then-layer = <19>;
        };

        MFree_Nav {
            if-layers = <18 9>;
            then-layer = <19>;
        };

        MOver1_Nav {
            if-layers = <18 12>;
            then-layer = <19>;
        };

        MOver2_ru {
            if-layers = <18 8>;
            then-layer = <19>;
        };

        MOver1_OS {
            if-layers = <27 12>;
            then-layer = <28>;
        };

        MOver2_OS {
            if-layers = <27 13>;
            then-layer = <28>;
        };

        Mouse_ru {
            if-layers = <5 2>;
            then-layer = <10>;
        };

        MFree_ru {
            if-layers = <2 4>;
            then-layer = <9>;
        };

        M1_ru {
            if-layers = <7 2>;
            then-layer = <12>;
        };

        M2_ru {
            if-layers = <8 2>;
            then-layer = <13>;
        };
    };
};

&pointer_accel {
    input-type = <INPUT_EV_REL>;
    min-factor = <1000>;        // 0.9x minimum
    max-factor = <1200>;       // 2.0x maximum
    speed-threshold = <1500>;  // Start accelerating later
    speed-max = <5000>;         // 6000 counts/sec for max accel
    acceleration-exponent = <1>; // Linear acceleration
    track-remainders;          // Track fractional movements
};

&zip_inertia {
    // Initiation delay (Wait time after input stops before starting inertia)
    // Recommended: AT LEAST 2x your sensor's polling interval (e.g., 30ms for 15ms sensor).
    trigger-ms = <3>;

    // --- Mouse Movement Settings ---
    move-decay-factor-int = <80>;       // Decay rate (0-100)
    move-report-interval-ms = <20>;     // Report interval (ms)
    move-threshold-start = <1>;        // Start threshold (pix/report)
    move-threshold-stop = <1>;          // Stop threshold (pix/report)
};

&mmv {
    acceleration-exponent = <0>; 
};

&msc {
    acceleration-exponent = <0>; 
};

&mmv_input_listener {
    input-processors = <&pointer_accel &zip_inertia>; 
};

&msc_input_listener {
    faster {
        layers = <30>;
        input-processors = <&zip_xy_scaler 3 2>;
    };

    slower {
        layers = <29>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

&mmv_input_listener {
    faster {
        layers = <30>;
        input-processors = <&zip_xy_scaler 3 2>;
    };

    slower {
        layers = <29>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};
