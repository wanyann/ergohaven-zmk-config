        Ru_CW {
            bindings = <
&trans                 &mt LS(RU_CYRILLIC_TSE) LS(RU_CYRILLIC_TSE)  &soft_caps 0 0                    &mt LS(RU_CYRILLIC_YA) LS(RU_CYRILLIC_YA)  &mmt LC(R) LS(RU_CYRILLIC_A)     &mt LC(T) LS(RU_CYRILLIC_YU)                    &mt LS(RU_CYRILLIC_ZE) LS(RU_CYRILLIC_ZE)  &mt LS(RU_CYRILLIC_VE) LS(RU_CYRILLIC_VE)  &mt LS(RU_CYRILLIC_KA) LS(RU_CYRILLIC_KA)  &mt LS(RU_CYRILLIC_DE) LS(RU_CYRILLIC_DE)    &mt LS(RU_CYRILLIC_SHCHA) LS(RU_CYRILLIC_SHCHA)  &trans
&kp LS(RU_CYRILLIC_E)  &hrml_slow LEFT_GUI LS(RU_CYRILLIC_SHORT_I)  &hrml LEFT_ALT LS(RU_CYRILLIC_I)  &hrml LEFT_SHIFT LS(RU_CYRILLIC_IE)        &hrml LCTRL LS(RU_CYRILLIC_O)    &ru_com_mt LC(F) 0                              &mt LS(RU_CYRILLIC_EL) LS(RU_CYRILLIC_EL)  &hrml RCTRL LS(RU_CYRILLIC_EN)             &hrml LEFT_SHIFT LS(RU_CYRILLIC_TE)        &hrosm_r RALT LS(RU_CYRILLIC_ES)             &hrml_slow RGUI LS(RU_CYRILLIC_CHE)              &mt LS(RU_CYRILLIC_SHA) LS(RU_CYRILLIC_SHA)
&trans                 &mmt LC(Z) LS(RU_CYRILLIC_EF)                &mmt LC(X) LS(RU_CYRILLIC_U)      &mmt LC(C) LS(RU_CYRILLIC_HA)              &mmt LC(V) LS(RU_CYRILLIC_YERU)  &ru_dot_mt LG(V) 0                              &mt LS(RU_CYRILLIC_BE) LS(RU_CYRILLIC_BE)  &mt LS(RU_CYRILLIC_EM) LS(RU_CYRILLIC_EM)  &mt LS(RU_CYRILLIC_PE) LS(RU_CYRILLIC_PE)  &mt LS(RU_CYRILLIC_GHE) LS(RU_CYRILLIC_GHE)  &mt LC(SLASH) LS(RU_CYRILLIC_ZHE)                &trans
                                                                    &trans                            &trans                                     &trans                           &ru_lt_cw_off 10 SPACE        &trans    &trans  &lt 12 LS(RU_CYRILLIC_ER)                  &trans                                     &trans                                     &trans
            >;
        };

        AutoMouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &ms_space 10 0  &trans    &trans  &trans  &trans  &trans  &trans
