#include "keys_ru.h"
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors/mouse_key_toggle.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zmk-input-inertia/input/processor/input_inertia.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#define ZMK_POINTING_DEFAULT_MOVE_VAL 125

&mt { flavor = "tap-preferred"; };

&lt {
    flavor = "balanced";
    bindings = <&mo>, <&long_kp>;

    tapping-term-ms = <180>;
};

&sl {
    release-after-ms = <5000>;
    ignore-modifiers;
};

&sk {
    release-after-ms = <30000>;
    quick-release;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <50>;
};

&mmv {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <50>;
};

&key_repeat { usage-pages = <HID_USAGE_KEY HID_USAGE_CONSUMER>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_ctrl_ent {
            bindings = <&long_kp LC(ENTER)>;
            key-positions = <2 4>;
            require-prior-idle-ms = <30>;
        };

        combo_enter {
            bindings = <&long_kp ENTER>;
            key-positions = <3 2>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        combo_tab {
            bindings = <&long_kp TAB>;
            key-positions = <14 15>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        combo_esc {
            bindings = <&long_kp ESC>;
            key-positions = <26 27>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        combo_ru {
            bindings = <&layer_ru>;
            key-positions = <15 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        combo_en {
            bindings = <&layer_en>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        combo_osl_sym_en {
            bindings = <&sl 17>;
            key-positions = <21 22>;
            require-prior-idle-ms = <50>;
            layers = <0 1 17>;
            timeout-ms = <30>;
        };

        combo_lessgreater_en {
            bindings = <&less_greater_en>;
            require-prior-idle-ms = <30>;
            key-positions = <31 33>;
            layers = <0 1 17>;
        };

        combo_osl_sym_ru {
            bindings = <&sl 18>;
            key-positions = <21 22>;
            require-prior-idle-ms = <50>;
            layers = <2 3 18>;
            timeout-ms = <30>;
        };

        combo_lessgreater_ru {
            bindings = <&less_greater_ru>;
            key-positions = <31 33>;
            require-prior-idle-ms = <30>;
            layers = <2 3>;
        };

        combo_braces_en {
            bindings = <&braces_en>;
            key-positions = <19 21>;
            require-prior-idle-ms = <50>;
            layers = <0 1 17>;
        };

        combo_asterisk_ru {
            bindings = <&kp RU_ASTERISK>;
            timeout-ms = <30>;
            key-positions = <7 9 8>;
            layers = <2 3 18 14 5>;
        };

        combo_asterisk_en {
            bindings = <&kp ASTERISK>;
            timeout-ms = <30>;
            key-positions = <7 8 9>;
            layers = <0 1 13 17 4>;
        };

        combo_capsword_en {
            bindings = <&layer_on 1>;
            key-positions = <14 13>;
            layers = <0 1>;
        };

        combo_osl_fn {
            bindings = <&sl 19>;
            key-positions = <26 28>;
        };

        combo_osl_os {
            bindings = <&sl 20>;
            key-positions = <25 26>;
        };

        combo_capsword_ru {
            bindings = <&layer_on 3>;
            key-positions = <14 13>;
            layers = <2 3>;
        };

        combo_plus {
            bindings = <&kp PLUS>;
            key-positions = <7 8>;
        };

        parentheses {
            bindings = <&parentheses>;
            key-positions = <14 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        combo_braces_ru {
            bindings = <&braces_ru>;
            key-positions = <19 21>;
            timeout-ms = <25>;
            layers = <2 3 18 5>;
            require-prior-idle-ms = <50>;
        };

        combo_brackets_en {
            bindings = <&brackets_en>;
            key-positions = <7 9>;
            layers = <0 1 17 4>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        combo_brackets_ru {
            bindings = <&brackets_ru>;
            key-positions = <7 9>;
            layers = <2 3 18 5>;
            timeout-ms = <30>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <31 32>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        combo_ru_at {
            bindings = <&en_kp AT>;
            key-positions = <14 15 16>;
            layers = <2 3 18 5>;
        };

        combo_en_at {
            bindings = <&kp AT>;
            key-positions = <16 15 14>;
            layers = <0 1 17 4>;
        };

        combo_quotes_en {
            bindings = <&quote_morph_en>;
            key-positions = <27 28>;
            layers = <0 1 13 17 4>;
        };

        combo_quotes_ru {
            bindings = <&quote_morph_ru>;
            key-positions = <27 28>;
            layers = <2 3 18 14 5>;
        };

        combo_slash_ru {
            bindings = <&slash_morph_ru>;
            key-positions = <3 4>;
            layers = <2 3 14 18 5>;
        };

        combo_slash_en {
            bindings = <&slash_morph_en>;
            key-positions = <3 4>;
            layers = <0 1 13 17 4>;
        };

        combo_arrow_ru {
            bindings = <&arrow_ru>;
            key-positions = <31 32 33>;
            layers = <2 3 14 18 5>;
        };

        combo_arrow_en {
            bindings = <&arrow_en>;
            key-positions = <31 33 32>;
            layers = <0 1 13 17 4>;
        };

        combo_and_ru {
            bindings = <&en_kp AMPERSAND>;
            key-positions = <2 3 4>;
            layers = <2 3 14 18 5>;
        };

        combo_and_en {
            bindings = <&kp AMPERSAND>;
            key-positions = <2 3 4>;
            layers = <0 1 13 17 4>;
        };

        combo_dollar_ru {
            bindings = <&en_kp DOLLAR>;
            key-positions = <19 20 21>;
            layers = <2 3 14 18 5>;
        };

        combo_dollar_en {
            bindings = <&kp DOLLAR>;
            key-positions = <19 20 21>;
            layers = <0 1 13 17 4>;
        };

        combo_hash_ru {
            bindings = <&en_kp HASH>;
            key-positions = <26 27 28>;
            layers = <2 3 14 18 5>;
        };

        combo_hash_en {
            bindings = <&kp HASH>;
            key-positions = <26 27 28>;
            layers = <0 1 13 17 4>;
        };

        combo_equal {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
        };

        combo_under {
            bindings = <&kp UNDER>;
            key-positions = <32 33>;
        };
    };

    macros {
        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_tap_time 30>,
                <&kp LS(LC(N8)) &mouse_off>;

            label = "LAYER_RU";
            tap-ms = <1>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_tap_time 30>,
                <&kp LS(LC(N9)) &mouse_off>;

            label = "LAYER_EN";
            tap-ms = <1>;
        };

        lg_ru: lg_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N8))>;
            label = "LG_RU";
        };

        lg_en: lg_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N9))>;
            label = "LG_EN";
        };

        en_kp: en_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LS(LC(N9)) &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp LS(LC(N8))>;
            label = "EN_KP";
        };

        ru_kp: ru_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LS(LC(N8)) &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp LS(LC(N9))>;
            label = "RU_KP";
        };

        mouse_off: mouse_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(F9))>;
            label = "MOUSE_OFF";
        };

        free: free {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(F10))>;
            label = "FREE";
        };

        overlay: overlay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(F11))>;
            label = "OVERLAY";
        };

        en_code: en_code_block {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE &kp RETURN &kp RET &kp GRAVE &kp GRAVE &kp GRAVE &kp UP_ARROW>;
            label = "EN_CODE_BLOCK";
            tap-ms = <50>;
        };

        ru_code: ru_code {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp GRAVE &kp GRAVE &kp GRAVE &kp RETURN &kp RET &kp GRAVE &kp GRAVE &kp GRAVE &kp UP_ARROW &lg_ru>;
            label = "RU_CODE";
            tap-ms = <50>;
            wait-ms = <10>;
        };

        ru_cw_off: ru_cw_off {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 2>;
            label = "RU_CW_OFF";
            wait-ms = <0>;
        };

        en_cw_off: en_cw_off {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 0>;
            label = "EN_CW_OFF";
            wait-ms = <0>;
        };

        zeros_macro: zeros_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0 &kp N0 &kp N0 &kp N0 &kp N0>;
            label = "ZEROS_MACRO";
        };

        ml: ml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 9>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 9>;

            label = "ML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        braces_en: braces_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BRACES_EN";
            wait-ms = <0>;
        };

        braces_ru: braces_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &braces_en &lg_ru>;
            label = "BRACES_RU";
            wait-ms = <0>;
        };

        brackets_en: brackets_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "BRACKETS_EN";
            wait-ms = <0>;
        };

        brackets_ru: brackets_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &brackets_en &lg_ru>;
            label = "BRACKETS_RU";
            wait-ms = <0>;
        };

        parentheses: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "PARENTHESES";
            wait-ms = <0>;
        };

        less_greater_en: less_greater_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp GREATER_THAN &kp LEFT>;
            label = "LESS_GREATER_EN";
            wait-ms = <0>;
        };

        less_greater_ru: less_greater_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &less_greater_en &lg_ru>;
            label = "LESS_GREATER_RU";
        };

        alt_spc_ru: alt_spc_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE) &mouse_off>, <&macro_tap_time 1>, <&to 2>;

            label = "ALT_SPC_RU";
            wait-ms = <0>;
        };

        testops: testops {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(LC(LG(F7)))>,
                <&macro_wait_time 100>,
                <&kp LEFT_ARROW &kp LS(LC(LG(F8)))>;

            label = "TESTOPS";
            wait-ms = <350>;
            tap-ms = <150>;
        };

        long_kp: long_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "LONG_KP";
            wait-ms = <50>;
        };

        bt_set: bt_set {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_SET";
            tap-ms = <20>;
        };

        arrow_en: arrow_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "ARROW_EN";
        };

        arrow_ru: arrow_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &arrow_en &lg_ru>;
            label = "ARROW_RU";
        };

        bt_set_en: bt_set_en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &bt_set MACRO_PLACEHOLDER &layer_off 20 &lg_en &lg_en>;
            label = "BT_SET_en";
            wait-ms = <45>;
            tap-ms = <40>;
        };

        one_shot: one_shot {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &sk MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&kp K_CANCEL>;

            label = "ONE_SHOT";
            tap-ms = <10>;
        };

        bt_set_ru: bt_set_ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &bt_set MACRO_PLACEHOLDER &layer_off 20 &lg_ru &lg_ru>;
            label = "BT_SET_RU";
            wait-ms = <45>;
            tap-ms = <40>;
        };

        vm_lang_ru: vm_lang {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &lg_ru &lg_ru>;
            label = "VM_LANG";
            wait-ms = <100>;
            tap-ms = <100>;
        };

        vm_lang_en: vm_lang_en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &lg_en &lg_en>;
            label = "VM_LANG_EN";
            wait-ms = <100>;
            tap-ms = <100>;
        };

        ms_free: ms_free {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&layer_on 4 &layer_off 7 &layer_off 8>;
            label = "MS_FREE";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        ms_over: ms_over {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&overlay>, <&macro_tap_time 1>, <&layer_on 7>;

            label = "MS_OVER";
            wait-ms = <0>;
        };

        kp_to: kp_to {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_2to1 &to MACRO_PLACEHOLDER>;
            label = "KP_TO";
        };

        kp_m2: kp_m2 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 1>,
                <&layer_on 4 &layer_off 8>;

            label = "KP_M2";
            tap-ms = <15>;
            wait-ms = <0>;
        };

        mouse_back: mouse_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp TAB>,
                <&macro_tap_time 1>,
                <&layer_on 7 &layer_off 8>;

            label = "MOUSE_BACK";
        };

        alt_spc_en: alt_spc_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE) &mouse_off>, <&macro_tap_time 1>, <&to 0>;

            label = "ALT_SPC_EN";
            wait-ms = <0>;
        };

        kp_free: kp_free {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &free>;
            label = "KP_FREE";
        };

        mouseoff_kp: mouseoff_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&layer_off 4 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MOUSEOFF_KP";
        };

        kp_m1: kp_m1 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 1>,
                <&layer_on 8 &layer_off 7>;

            label = "KP_M1";
            tap-ms = <15>;
            wait-ms = <0>;
        };

        overoff_sl: overoff_sl {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&mouse_off &macro_param_1to1 &layer_off MACRO_PLACEHOLDER &macro_param_2to1 &sl MACRO_PLACEHOLDER>;
            label = "OVEROFF_SL";
        };

        ms_set: ms_set {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp SPACE &kp RU_CYRILLIC_EF>,
                <&macro_wait_time 0>,
                <&kp RU_CYRILLIC_ZE>,
                <&macro_tap_time 1>,
                <&layer_on 4 &layer_off 7 &layer_off 8>;

            label = "MS_SET";
        };

        macro_unsafe_en: macro_unsafe_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp I &kp S &kp I &kp S &kp U &kp N &kp S &kp A &kp F &kp E>;
            label = "MACRO_UNSAFE_EN";
            wait-ms = <30>;
        };

        macro_unsafe_ru: macro_unsafe_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp T &kp H &kp I &kp S &kp I &kp S &kp U &kp N &kp S &kp A &kp F &kp E &lg_ru>;
            label = "MACRO_UNSAFE_RU";
            wait-ms = <30>;
        };

        mml: mml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 6>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 6>;

            label = "MML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        moff_kp: moff_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&layer_off 4 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MOFF_KP";
        };

        cmd_scroll: cmd_scroll {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &macro_param_1to1 &mscl MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mscl MACRO_PLACEHOLDER &kp LEFT_GUI>;

            label = "CMD_SCROLL";
            wait-ms = <0>;
        };

        mkpl: mkpl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>;

            label = "MKPL";
            wait-ms = <50>;
        };

        mmvl: mmvl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mmv MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mmv MACRO_PLACEHOLDER>;

            label = "MMVL";
            wait-ms = <125>;
        };

        mscl: mscl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &msc MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &msc MACRO_PLACEHOLDER>;

            label = "MSCL";
            wait-ms = <100>;
        };

        mod_layer: mod_layer {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &macro_param_2to1 &layer_on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1 &layer_off MACRO_PLACEHOLDER &macro_param_1to1 &key_off MACRO_PLACEHOLDER>;

            label = "MOD_LAYER";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        esc_over_off: esc_over_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&long_kp ESC>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&long_kp ESC>,
                <&macro_tap_time 1>,
                <&layer_off 7 &layer_off 8>;

            label = "ESC_OVER_OFF";
            wait-ms = <0>;
        };

        switch_mon: switch_mon {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &layer_on 7 &layer_off 8>;
            label = "SWITCH_MON";
            wait-ms = <0>;
        };

        lkp_moff: lkp_moff {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_wait_time 0>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "LKP_MOFF";
            wait-ms = <100>;
        };

        mouse_mod: mouse_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 24 &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &mo 24>;

            label = "MOUSE_MOD";
        };

        left_ctrl: sm_left {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &mmvl MOVE_LEFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mmvl MOVE_LEFT &macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "SM_LEFT";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        down_shift: sm_down {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &mdown_morph>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mdown_morph &macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "SM_DOWN";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        right_alt: right_alt {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &mright_morph>,
