        };

        td_quotes_ru: td_quotes_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUOTES_RU";
            #binding-cells = <0>;
            bindings = <&kp RU_DOUBLE_QUOTES>, <&quotes_ru>;

            tapping-term-ms = <250>;
        };

        td_quotes_en: td_quotes_en {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUOTES_EN";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES>, <&quotes_en>;

            tapping-term-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        En {
            bindings = <
&kp BACKSPACE  &none                  &kp Y                  &kp U                &mt LC(R) A          &mt LC(T) APOS                                      &kp Q     &kp G        &kp N                &kp W       &kp Z              &none
&kp J          &hrml_slow LEFT_GUI H  &hrml_slow LEFT_ALT I  &hrs_l LEFT_SHIFT E  &hrml LCTRL O        &en_com_mt LC(F) 0                                  &kp M     &hrl 10 D    &hrs_r LEFT_SHIFT R  &kp S       &hrml_slow RALT P  &kp K
&kp DELETE     &mt LC(Z) X            &mt LC(X) K_CANCEL     &mt LC(C) K_CANCEL   &mt LC(V) SQT        &en_dot_mt LG(V) 0                                  &kp V     &kp C        &kp L                &kp F       &mt LC(SLASH) B    &none
                                      &kp LS(F7)             &kp F7               &en_cw_off K_CANCEL  &lt 9 SPACE         &sl 12    &one_shot LEFT_SHIFT  &lt 10 T  &bspc_morph  &kp F2               &kp LS(F2)
            >;

            display-name = "English";
        };

        En_CW {
            bindings = <
&trans     &none                      &kp LS(Y)                  &kp LS(U)                &mt LC(R) LS(A)      &mt LC(T) APOS                           &kp LS(Q)     &kp LS(G)      &kp LS(N)                &kp LS(W)  &kp LS(Z)              &trans
&kp LS(J)  &hrml_slow LEFT_GUI LS(H)  &hrml_slow LEFT_ALT LS(I)  &hrs_l LEFT_SHIFT LS(E)  &hrml LCTRL LS(O)    &en_com_mt LC(F) 0                       &kp LS(M)     &hrl 10 LS(D)  &hrs_r LEFT_SHIFT LS(R)  &kp LS(S)  &hrml_slow RALT LS(P)  &kp LS(K)
&trans     &mt LC(Z) LS(X)            &mt LC(X) K_CANCEL         &mt LC(C) K_CANCEL       &mt LC(V) SQT        &en_dot_mt LG(V) 0                       &kp LS(V)     &kp LS(C)      &kp LS(L)                &kp LS(F)  &mt LC(SLASH) LS(B)    &trans
                                      &trans                     &trans                   &en_cw_off K_CANCEL  &en_lt_cw_off 9 SPACE  &trans    &trans  &lt 10 LS(T)  &trans         &trans                   &trans
            >;

            display-name = "CapsWord";
        };

        Ru {
            bindings = <
&trans             &kp RU_CYRILLIC_TSE                      &soft_sign                         &kp RU_CYRILLIC_YA                &mt LC(R) RU_CYRILLIC_A     &mt LC(T) RU_CYRILLIC_YU                    &kp RU_CYRILLIC_ZE     &kp RU_CYRILLIC_VE      &kp RU_CYRILLIC_KA                &kp RU_CYRILLIC_DE   &kp RU_CYRILLIC_SHCHA            &trans
&kp RU_CYRILLIC_E  &hrml_slow LEFT_GUI RU_CYRILLIC_SHORT_I  &hrml_slow LEFT_ALT RU_CYRILLIC_I  &hrs_l LEFT_SHIFT RU_CYRILLIC_IE  &hrml LCTRL RU_CYRILLIC_O   &ru_com_mt LC(F) 0                          &kp RU_CYRILLIC_EL     &hrl 11 RU_CYRILLIC_EN  &hrs_r LEFT_SHIFT RU_CYRILLIC_TE  &kp RU_CYRILLIC_ES   &hrml_slow RALT RU_CYRILLIC_CHE  &kp RU_CYRILLIC_SHA
&trans             &mt LC(Z) RU_CYRILLIC_EF                 &mt LC(X) RU_CYRILLIC_U            &mt LC(C) RU_CYRILLIC_HA          &mt LC(V) RU_CYRILLIC_YERU  &ru_dot_mt LG(V) 0                          &kp RU_CYRILLIC_BE     &kp RU_CYRILLIC_EM      &kp RU_CYRILLIC_PE                &kp RU_CYRILLIC_GHE  &mt LC(SLASH) RU_CYRILLIC_ZHE    &trans
                                                            &trans                             &trans                            &ru_cw_off K_CANCEL         &trans                    &trans    &trans  &lt 11 RU_CYRILLIC_ER  &trans                  &trans                            &trans
            >;

            display-name = "Russian";
        };

        Ru_CW {
            bindings = <
&trans                 &kp LS(RU_CYRILLIC_TSE)                      &caps_soft_sign                        &kp LS(RU_CYRILLIC_YA)                &mt LC(R) LS(RU_CYRILLIC_A)     &mt LC(T) LS(RU_CYRILLIC_YU)                    &kp LS(RU_CYRILLIC_ZE)     &kp LS(RU_CYRILLIC_VE)      &kp LS(RU_CYRILLIC_KA)                &kp LS(RU_CYRILLIC_DE)   &kp LS(RU_CYRILLIC_SHCHA)            &trans
&kp LS(RU_CYRILLIC_E)  &hrml_slow LEFT_GUI LS(RU_CYRILLIC_SHORT_I)  &hrml_slow LEFT_ALT LS(RU_CYRILLIC_I)  &hrs_l LEFT_SHIFT LS(RU_CYRILLIC_IE)  &hrml LCTRL LS(RU_CYRILLIC_O)   &ru_com_mt LC(F) 0                              &kp LS(RU_CYRILLIC_EL)     &hrl 10 LS(RU_CYRILLIC_EN)  &hrs_r LEFT_SHIFT LS(RU_CYRILLIC_TE)  &kp LS(RU_CYRILLIC_ES)   &hrml_slow RALT LS(RU_CYRILLIC_CHE)  &kp LS(RU_CYRILLIC_SHA)
&trans                 &mt LC(Z) LS(RU_CYRILLIC_EF)                 &mt LC(X) LS(RU_CYRILLIC_U)            &mt LC(C) LS(RU_CYRILLIC_HA)          &mt LC(V) LS(RU_CYRILLIC_YERU)  &ru_dot_mt LG(V) 0                              &kp LS(RU_CYRILLIC_BE)     &kp LS(RU_CYRILLIC_EM)      &kp LS(RU_CYRILLIC_PE)                &kp LS(RU_CYRILLIC_GHE)  &mt LC(SLASH) LS(RU_CYRILLIC_ZHE)    &trans
                                                                    &trans                                 &trans                                &ru_cw_off K_CANCEL             &ru_lt_cw_off 9 SPACE         &trans    &trans  &lt 11 LS(RU_CYRILLIC_ER)  &trans                      &trans                                &trans
            >;

            display-name = "CapsWord";
        };

        Mouse {
            bindings = <
&trans  &trans     &trans        &kp KP_NUMLOCK  &trans                       &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LCTRL  &kp LEFT_ALT  &kp LSHFT       &trans                       &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans        &trans          &trans                       &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                   &trans        &trans          &kp_layeroff 4 LS(K_CANCEL)  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Mouse";
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Scroll";
        };

        Sniper {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Sniper";
        };

        Mouse_Ctrl {
            bindings = <
&trans  &kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(COMMA)  &kp LC(DOT)                    &kp LC(J)  &kp LC(L)  &kp LC(Y)  &kp LC(B)  &kp LC(SEMI)   &trans
&trans  &kp LC(A)  &trans     &kp LC(S)  &kp T          &kp LC(G)                      &kp LC(M)  &kp LC(N)  &kp LC(E)  &kp LC(L)  &kp LC(O)      &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(D)      &kp LC(V)                      &kp LC(K)  &kp LC(H)  &kp LC(U)  &kp LC(P)  &kp LC(SLASH)  &trans
                   &trans     &trans     &trans         &space_mrph  &trans    &trans  &trans     &trans     &trans     &trans
            >;

            display-name = "Mouse_Ctrl";
        };

        Mods {
            bindings = <
&trans  &kp Q             &kp W             &kp E              &kp R         &kp T                            &kp Y  &kp U      &kp I              &kp O    &kp P                &trans
&trans  &hrm_slow LGUI A  &hrm_slow LALT S  &hrm LEFT_SHIFT D  &hrm LCTRL F  &kp G                            &kp H  &hrl 10 J  &hrm LEFT_SHIFT K  &kp L    &hrm_slow RALT SEMI  &trans
&trans  &kp Z             &kp X             &kp C              &kp V         &kp B                            &kp N  &kp M      &kp COMMA          &kp DOT  &kp SLASH            &trans
                          &trans            &trans             &trans        &space_lt 9 0  &trans    &trans  &none  &trans     &trans             &trans
            >;

            display-name = "Modifiers";
        };

        Nav {
            bindings = <
&trans  &trans                          &kp LA(LC(GRAVE))                &kp LC(LS(LA(LG(TAB))))  &kp LS(LC(LA(LG(F1))))    &testops                                     &kp PG_UP     &kp HOME      &kp UP    &kp END    &kp DELETE   &trans
&trans  &hrm LEFT_GUI LC(LEFT_BRACKET)  &hrm LALT LC(RIGHT_BRACKET)      &kp LSHFT                &mod_dtap LCTRL LEFT_GUI  &zeros_macro                                 &select_word  &kp LEFT      &kp DOWN  &kp RIGHT  &select_row  &trans
&trans  &mt LC(Z) LG(LS(LEFT_BRACKET))  &mt LC(X) LG(LS(RIGHT_BRACKET))  &mt LC(C) LS(F6)         &mt LC(V) LS(LC(LA(V)))   &kp LS(LG(LC(F9)))                           &kp PG_DN     &kp CAPSLOCK  &none     &trans     &trans       &trans
                                        &trans                           &trans                   &trans                    &alt_spc            &kp LA(ENTER)    &trans  &trans        &trans        &trans    &trans
            >;

            display-name = "Naviagition";
        };

        Num_En {
            bindings = <
&trans  &kp ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &nine_morph  &kp MINUS                             &trans  &trans     &trans      &trans        &trans        &trans
&trans  &zero_morph   &kp N1        &kp N2        &three_mrph  &plus_morph                           &trans  &kp LCTRL  &kp LSHIFT  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans  &kp EQUAL     &kp N4        &kp N5        &kp N6       &kp LC(B)                             &trans  &trans     &kp COMMA   &kp DOT       &trans        &trans
                      &trans        &trans        &trans       &alt_spc     &kp LA(ENTER)    &trans  &trans  &trans     &trans      &trans
            >;

            display-name = "Numbers";
        };

        Num_Ru {
            bindings = <
&trans  &kp RU_ASTRK  &kp NUMBER_7  &kp NUMBER_8  &nine_morph  &kp MINUS                             &trans  &trans     &trans        &trans        &trans        &trans
&trans  &zero_morph   &kp N1        &kp N2        &three_mrph  &plus_morph                           &trans  &kp LCTRL  &kp LSHIFT    &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans  &kp EQUAL     &kp N4        &kp N5        &kp N6       &kp LC(B)                             &trans  &trans     &kp RU_COMMA  &kp RU_DOT    &trans        &trans
                      &trans        &trans        &trans       &alt_spc     &kp LA(ENTER)    &trans  &trans  &trans     &trans        &trans
            >;

            display-name = "Numbers";
        };

        App {
            bindings = <
&trans                        &kp LA(LC(LS(P)))  &kp LS(LA(LC(W)))  &kp LS(LA(LC(E)))  &kp LS(LA(LC(R)))  &kp LS(LA(LC(T)))                    &kp LS(LA(LC(Y)))  &kp LS(LA(LC(U)))  &kp LS(LA(LC(I)))      &kp LS(LA(LC(O)))    &kp LS(LA(LC(P)))          &trans
&kp LS(LA(LC(LEFT_BRACKET)))  &kp LS(LA(LC(A)))  &kp LS(LA(LC(S)))  &kp LS(LA(LC(D)))  &kp LS(LA(LC(F)))  &kp LS(LA(LC(G)))                    &kp LS(LA(LC(H)))  &kp LS(LA(LC(J)))  &kp LS(LA(LC(K)))      &kp LS(LA(LC(L)))    &kp LS(LA(LC(SEMICOLON)))  &kp LS(LA(LC(RIGHT_BRACKET)))
&trans                        &kp LS(LC(LA(Z)))  &kp LS(LA(LC(X)))  &kp LS(LA(LC(C)))  &kp LS(LC(LG(V)))  &kp LS(LA(LC(B)))                    &kp LS(LA(LC(N)))  &kp LS(LC(LA(M)))  &kp LS(LA(LC(COMMA)))  &kp LS(LA(LC(DOT)))  &kp LS(LC(LA(SLASH)))      &trans
                                                 &trans             &trans             &layer_off 12      &none              &sl 12    &trans  &trans             &trans             &trans                 &trans
            >;

            display-name = "Application";
        };

        Sym_En {
            bindings = <
&trans  &trans  &none                 &none   &none                  &trans                      &trans         &kp LEFT_BRACKET  &ru RU_RUBLE  &kp RIGHT_BRACKET  &trans  &trans
&trans  &trans  &kp LEFT_PARENTHESIS  &none   &kp RIGHT_PARENTHESIS  &kp PLUS                    &ru RU_NUMERO  &kp LEFT_BRACE    &none         &kp RIGHT_BRACE    &trans  &trans
&trans  &trans  &kp TILDE             &none   &kp PERCENT            &en_code                    &trans         &kp LESS_THAN     &kp CARET     &kp GREATER_THAN   &trans  &trans
                &trans                &trans  &trans                 &trans    &trans    &trans  &trans         &trans            &trans        &trans
            >;

            display-name = "Symbols";
