#include "keys_ru.h"
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors/mouse_key_toggle.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zmk-input-inertia/input/processor/input_inertia.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#define ZMK_POINTING_DEFAULT_MOVE_VAL 125

&mt {
    flavor = "tap-preferred";
    bindings = <&moff_tap>, <&moff_kp>;

    tapping-term-ms = <200>;
};

&lt {
    flavor = "balanced";
    bindings = <&mo>, <&long_kp>;

    tapping-term-ms = <200>;
};

&sl {
    release-after-ms = <5000>;
    ignore-modifiers;
};

&sk {
    release-after-ms = <30000>;
    quick-release;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <50>;
};

&mmv {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <50>;
};

&key_repeat { usage-pages = <HID_USAGE_KEY HID_USAGE_CONSUMER>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_ctrl_ent {
            bindings = <&long_kp LC(ENTER)>;
            key-positions = <>;
            require-prior-idle-ms = <30>;
        };

        combo_enter {
            bindings = <&long_kp ENTER>;
            key-positions = <>;
            require-prior-idle-ms = <30>;
        };

        combo_tab {
            bindings = <&long_kp TAB>;
            key-positions = <>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        combo_esc {
            bindings = <&kp_overoff ESC>;
            key-positions = <>;
            require-prior-idle-ms = <30>;
        };

        combo_ru {
            bindings = <&layer_ru>;
            key-positions = <>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        combo_en {
            bindings = <&layer_en>;
            key-positions = <>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        combo_osl_sym_en {
            bindings = <&sl 16>;
            key-positions = <>;
            require-prior-idle-ms = <50>;
            layers = <0 1 16>;
            timeout-ms = <30>;
        };

        combo_lessgreater_en {
            bindings = <&less_greater_en>;
            require-prior-idle-ms = <20>;
            key-positions = <31 33>;
            layers = <0 1 16 4>;
        };

        combo_osl_sym_ru {
            bindings = <&sl 17>;
            key-positions = <>;
            require-prior-idle-ms = <50>;
            layers = <2 3 17>;
            timeout-ms = <30>;
        };

        combo_lessgreater_ru {
            bindings = <&less_greater_ru>;
            key-positions = <31 33>;
            require-prior-idle-ms = <30>;
            layers = <2 3>;
        };

        combo_braces_en {
            bindings = <&braces_en>;
            key-positions = <19 21>;
            require-prior-idle-ms = <20>;
            layers = <0 1 16 4>;
            timeout-ms = <30>;
        };

        combo_asterisk_ru {
            bindings = <&kp RU_ASTERISK>;
            key-positions = <>;
            layers = <2 3 17 13 5>;
        };

        combo_asterisk_en {
            bindings = <&kp ASTERISK>;
            key-positions = <>;
            layers = <0 1 12 16 4>;
        };

        combo_capsword_en {
            bindings = <&layer_on 1>;
            key-positions = <>;
            layers = <0 1>;
        };

        combo_osl_fn {
            bindings = <&sl 18>;
            key-positions = <26 28>;
        };

        combo_osl_os {
            bindings = <&sl 19>;
            key-positions = <25 26>;
        };

        combo_capsword_ru {
            bindings = <&layer_on 3>;
            key-positions = <>;
            layers = <2 3>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <>;
        };

        parentheses {
            bindings = <&parentheses>;
            key-positions = <14 16>;
            require-prior-idle-ms = <20>;
            timeout-ms = <30>;
        };

        combo_braces_ru {
            bindings = <&braces_ru>;
            key-positions = <19 21>;
            layers = <2 3 17 5>;
            require-prior-idle-ms = <20>;
            timeout-ms = <30>;
        };

        combo_brackets_en {
            bindings = <&brackets_en>;
            key-positions = <7 9>;
            layers = <0 1 16 4>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        combo_brackets_ru {
            bindings = <&brackets_ru>;
            key-positions = <7 9>;
            layers = <2 3 17 5>;
        };

        combo_equal {
            bindings = <&kp EQUAL>;
            key-positions = <>;
        };

        combo_quotes_en {
            bindings = <&quote_morph_en>;
            key-positions = <32 31>;
            layers = <0 1 12 16 4 8 10 14 19>;
        };

        combo_quotes_ru {
            bindings = <&quote_morph_ru>;
            key-positions = <31 32>;
            layers = <2 3 17 13 9 5 11 15 20>;
        };

        combo_slash_ru {
            bindings = <&slash_morph_ru>;
            key-positions = <7 8>;
            layers = <2 3 13 17 5 9 11 15 20>;
        };

        combo_slash_en {
            bindings = <&slash_morph_en>;
            key-positions = <7 8>;
            layers = <0 1 12 16 4 8 10 14 19>;
        };

        combo_arrow_ru {
            bindings = <&arrow_ru>;
            key-positions = <31 32 33>;
            layers = <2 3 13 17 5 9 11 15 20>;
        };

        combo_arrow_en {
            bindings = <&arrow_en>;
            key-positions = <31 33 32>;
            layers = <0 1 12 16 4 8 10 14 19>;
        };

        combo_mclick {
            bindings = <&mkp MB3>;
            key-positions = <2 3>;
            layers = <4 5 14 15 23>;
            timeout-ms = <50>;
        };

        combo_lclick {
            bindings = <&mkp MB1>;
            key-positions = <14 15>;
            layers = <4 5 14 15 23>;
            timeout-ms = <50>;
        };

        combo_rclick {
            bindings = <&mkp MB2>;
            key-positions = <16 15>;
            layers = <4 5 14 15 23>;
            timeout-ms = <50>;
        };

        combo_shft_click {
            bindings = <&mod_click LEFT_SHIFT>;
            key-positions = <26 27>;
            layers = <4 5 14 15>;
            timeout-ms = <50>;
        };

        combo_alt_click {
            bindings = <&alt_click LEFT_ALT>;
            key-positions = <3 4>;
            layers = <4 5 14 15>;
            timeout-ms = <50>;
        };

        combo_cmd_click {
            bindings = <&mod_click LCTRL>;
            key-positions = <27 28>;
            layers = <4 5 14 15 23>;
            timeout-ms = <50>;
        };

        combo_cmd_shift_click {
            bindings = <&mod_click LS(LCTRL)>;
            key-positions = <26 27 28>;
            layers = <4 5 14 15 23>;
            timeout-ms = <50>;
        };
    };

    macros {
        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 2>, <&macro_tap_time 30>, <&kp LS(LC(N8))>;

            label = "LAYER_RU";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_tap_time 30>, <&kp LS(LC(N9))>;

            label = "LAYER_EN";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        lg_ru: lg_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N8))>;
            label = "LG_RU";
        };

        lg_en: lg_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N9))>;
            label = "LG_EN";
        };

        en_kp: en_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LS(LC(N9)) &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp LS(LC(N8))>;
            label = "EN_KP";
        };

        ru_kp: ru_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LS(LC(N8)) &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp LS(LC(N9))>;
            label = "RU_KP";
        };

        mouse_off: mouse_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(F9))>;
            label = "MOUSE_OFF";
        };

        free: free {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(F10))>;
            label = "FREE";
        };

        overlay: overlay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(F11))>;
            label = "OVERLAY";
        };

        en_code: en_code_block {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE &kp RETURN &kp RET &kp GRAVE &kp GRAVE &kp GRAVE &kp HOME &kp LEFT>;
            label = "EN_CODE_BLOCK";
            tap-ms = <50>;
        };

        ru_code: ru_code {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp GRAVE &kp GRAVE &kp GRAVE &kp RETURN &kp RET &kp GRAVE &kp GRAVE &kp GRAVE &kp HOME &kp LEFT &lg_ru>;
            label = "RU_CODE";
            tap-ms = <50>;
            wait-ms = <10>;
        };

        ru_cw_off: ru_cw_off {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 2>;
            label = "RU_CW_OFF";
            wait-ms = <0>;
        };

        en_cw_off: en_cw_off {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &to 0>;
            label = "EN_CW_OFF";
            wait-ms = <0>;
        };

        zeros_macro: zeros_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0 &kp N0 &kp N0 &kp N0 &kp N0>;
            label = "ZEROS_MACRO";
        };

        ml: ml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_off 4 &layer_on 8 &macro_param_1to1 &key_on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 8>;

            label = "ML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        braces_en: braces_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "BRACES_EN";
            wait-ms = <0>;
        };

        braces_ru: braces_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&lg_en &kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT &lg_ru>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "BRACES_RU";
            wait-ms = <0>;
        };

        brackets_en: brackets_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "BRACKETS_EN";
            wait-ms = <0>;
        };

        brackets_ru: brackets_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&lg_en &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW &lg_ru>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "BRACKETS_RU";
            wait-ms = <0>;
        };

        parentheses: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "PARENTHESES";
            wait-ms = <0>;
        };

        less_greater_en: less_greater_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LESS_THAN &kp GREATER_THAN &kp LEFT>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "LESS_GREATER_EN";
            wait-ms = <0>;
        };

        less_greater_ru: less_greater_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&lg_en &kp LESS_THAN &kp GREATER_THAN &kp LEFT_ARROW &lg_ru>,
                <&macro_press>,
                <&layer_off 4>;

            label = "LESS_GREATER_RU";
        };

        alt_spc_ru: alt_spc_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE) &layer_en>;
            label = "ALT_SPC_RU";
            wait-ms = <0>;
        };

        testops: testops {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(LC(LG(F7)))>,
                <&macro_wait_time 100>,
                <&kp LEFT_ARROW &kp LS(LC(LG(F8)))>;

            label = "TESTOPS";
            wait-ms = <350>;
            tap-ms = <150>;
        };

        long_kp: long_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "LONG_KP";
            wait-ms = <75>;
        };

        bt_set: bt_set {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_SET";
            tap-ms = <20>;
        };

        arrow_en: arrow_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp MINUS &kp GREATER_THAN>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "ARROW_EN";
        };

        arrow_ru: arrow_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&lg_en &arrow_en &lg_ru>,
                <&macro_tap_time 1>,
                <&layer_off 4>;

            label = "ARROW_RU";
        };

        bt_set_en: bt_set_en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &bt_set MACRO_PLACEHOLDER &layer_off 19 &lg_en &lg_en>;
            label = "BT_SET_en";
            wait-ms = <45>;
            tap-ms = <40>;
        };

        one_shot: one_shot {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &sk MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&kp K_CANCEL>;

            label = "ONE_SHOT";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        bt_set_ru: bt_set_ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &bt_set MACRO_PLACEHOLDER &layer_off 19 &lg_ru &lg_ru>;
            label = "BT_SET_RU";
            wait-ms = <45>;
            tap-ms = <40>;
        };

        vm_lang_ru: vm_lang {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &lg_ru &lg_ru>;
            label = "VM_LANG";
            wait-ms = <100>;
            tap-ms = <100>;
        };

        vm_lang_en: vm_lang_en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &lg_en &lg_en>;
            label = "VM_LANG_EN";
            wait-ms = <100>;
            tap-ms = <100>;
        };

        ms_free: ms_free {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mouse_off>,
                <&macro_tap_time 1>,
                <&layer_on 0 &layer_off 6 &layer_off 7 &layer_off 4>;

            label = "MS_FREE";
            wait-ms = <0>;
        };

        ms_over: ms_over {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&overlay>,
                <&macro_tap_time 1>,
                <&layer_on 6 &layer_off 0 &layer_off 4>;

            label = "MS_OVER";
            wait-ms = <0>;
        };

        kp_to: kp_to {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_2to1 &to MACRO_PLACEHOLDER>;
            label = "KP_TO";
        };

        kp_m2: kp_m2 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_on 0 &layer_off 7>,
                <&macro_tap_time 15>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "KP_M2";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        mouse_back: mouse_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp TAB>,
                <&macro_tap_time 1>,
                <&layer_on 6 &layer_off 7>;

            label = "MOUSE_BACK";
        };

        alt_spc_en: alt_spc_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE) &layer_en>;
            label = "ALT_SPC_EN";
        };

        kp_free: kp_free {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &layer_on 0>;
            label = "KP_FREE";
        };

        kp_m1: kp_m1 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_on 7 &layer_off 6>,
                <&macro_tap_time 15>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "KP_M1";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        overoff_sl: overoff_sl {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&mouse_off &macro_param_1to1 &layer_off MACRO_PLACEHOLDER &macro_param_2to1 &sl MACRO_PLACEHOLDER>;
            label = "OVEROFF_SL";
        };

        ms_set: ms_set {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp SPACE &kp RU_CYRILLIC_I>,
                <&macro_wait_time 0>,
                <&kp RU_CYRILLIC_VE>,
                <&macro_tap_time 1>,
                <&layer_on 0 &layer_off 6 &layer_off 7>;

            label = "MS_SET";
        };

        macro_unsafe_en: macro_unsafe_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp I &kp S &kp I &kp S &kp U &kp N &kp S &kp A &kp F &kp E>;
            label = "MACRO_UNSAFE_EN";
            wait-ms = <30>;
        };

        macro_unsafe_ru: macro_unsafe_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp T &kp H &kp I &kp S &kp I &kp S &kp U &kp N &kp S &kp A &kp F &kp E &lg_ru>;
            label = "MACRO_UNSAFE_RU";
            wait-ms = <30>;
        };

        mml: mml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 0>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 0>;

            label = "MML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        moff_kp: moff_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_off 4 &macro_param_1to1 &key_on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER>;

            label = "MOFF_KP";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        cmd_scroll: cmd_scroll {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &macro_param_1to1 &mscl MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mscl MACRO_PLACEHOLDER &kp LEFT_GUI>;

            label = "CMD_SCROLL";
            wait-ms = <0>;
        };

        mkpl: mkpl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>;

            label = "MKPL";
            wait-ms = <50>;
        };

        mmvl: mmvl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mmv MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mmv MACRO_PLACEHOLDER>;

            label = "MMVL";
            wait-ms = <125>;
        };

        mscl: mscl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &msc MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &msc MACRO_PLACEHOLDER>;

            label = "MSCL";
            wait-ms = <100>;
        };

        mod_layer: mod_layer {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &macro_param_2to1 &layer_on MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1 &layer_off MACRO_PLACEHOLDER &macro_param_1to1 &key_off MACRO_PLACEHOLDER>;

            label = "MOD_LAYER";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        esc_over_off: esc_over_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&long_kp ESC>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&long_kp ESC>,
                <&macro_tap_time 1>,
                <&layer_off 6 &layer_off 7>;

            label = "ESC_OVER_OFF";
            wait-ms = <0>;
        };

        switch_mon: switch_mon {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &layer_on 6 &layer_off 7>;
            label = "SWITCH_MON";
            wait-ms = <0>;
        };

        lkp_moff: lkp_moff {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_off 4>,
                <&macro_wait_time 30>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "LKP_MOFF";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        mouse_mod: mouse_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &mo 0>;

            label = "MOUSE_MOD";
        };

        left_ctrl: sm_left {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &mmvl MOVE_LEFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mmvl MOVE_LEFT &macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "SM_LEFT";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        down_shift: sm_down {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &mdown_morph>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mdown_morph &macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "SM_DOWN";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        right_alt: right_alt {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &mright_morph>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mright_morph &macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "RIGHT_ALT";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        over_ms_free: over_ms_free {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mouse_off>, <&macro_tap_time 1>, <&ms_free>;

            label = "OVER_MS_FREE";
            wait-ms = <0>;
        };

        kp_overoff: esc_msoff {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_off 6 &layer_off 7>,
                <&macro_tap_time 75>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "ESC_MSOFF";
            wait-ms = <0>;
            tap-ms = <1>;
        };

        overoff_ru: overoff_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mouse_off>,
                <&macro_tap_time 1>,
                <&to 2>,
                <&macro_tap_time 30>,
                <&kp LS(LC(N8))>;

            label = "OVEROFF_RU";
        };

        overoff_en: overoff_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mouse_off>,
                <&macro_tap_time 1>,
                <&to 0>,
                <&macro_tap_time 30>,
                <&kp LS(LC(N9))>;

            label = "OVEROFF_EN";
        };

        mod_click: mod_click {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &mkp LCLK &macro_param_1to1 &key_off MACRO_PLACEHOLDER>;
            label = "MOD_CLICK";
        };

        click: click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&layer_off 4>,
                <&macro_press>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK>,
                <&macro_tap>,
                <&click_layer 23>;

            label = "CLICK";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        mkp_moff: mkp_moff {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_off 4>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>;

            label = "MKP_MOFF";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        osm: osm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &sk MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>;

            label = "OSM";
            tap-ms = <1>;
            wait-ms = <0>;
        };

        tap: tap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>;

            label = "TAP";
            tap-ms = <50>;
        };

        moff_tap: moff_tap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&layer_off 4>,
                <&macro_tap_time 50>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>;

            label = "MOFF_TAP";
            tap-ms = <0>;
            wait-ms = <0>;
        };

        alt_click: alt_click {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "ALT_CLICK";
            tap-ms = <0>;
            wait-ms = <50>;
        };
    };

    behaviors {
        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        hrm_slow: hrm_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_SLOW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        ru_lt_cw_off: ru_lt_cw_off {
            compatible = "zmk,behavior-hold-tap";
            label = "RU_LT_CW_OFF";
            bindings = <&mo>, <&ru_cw_off>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        en_lt_cw_off: en_lt_cw_off {
            compatible = "zmk,behavior-hold-tap";
            label = "EN_LT_CW_OFF";
            bindings = <&mo>, <&en_cw_off>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        bspc_morph: bspc_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_MORPH";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        key_on: key_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_ON";
            #binding-cells = <1>;
        };

        key_off: key_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&ml>, <&moff_kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ON";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        hrml_slow: hrml_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML_SLOW";
            bindings = <&ml>, <&moff_kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        soft_sign: soft_sign {
            compatible = "zmk,behavior-mod-morph";
            label = "SOFT_SIGN";
            bindings = <&kp RU_CYRILLIC_SOFT_SIGN>, <&kp RU_CYRILLIC_HARD_SIGN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        en_dot_excl: en_dot_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "EN_DOT_EXCL";
            bindings = <&morph_en_dot>, <&en_cw_off COLON>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_RGUI)>;
        };

        en_com_ques: en_com_ques {
            compatible = "zmk,behavior-mod-morph";
            label = "EN_COM_QUES";
            bindings = <&morph_en_com>, <&en_cw_off SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_RGUI)>;
        };

        ru_dot_excl: ru_dot_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_DOT_EXCL";
            bindings = <&morph_ru_dot>, <&ru_cw_off RU_COLON>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_RGUI)>;
        };

        ru_com_ques: ru_com_ques {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_COM_QUES";
            bindings = <&morph_ru_com>, <&ru_cw_off RU_SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_RGUI)>;
        };

        ru_dot_mt: ru_dot_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "RU_DOT_MT";
            bindings = <&moff_tap>, <&ru_dot_excl>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        ru_com_mt: ru_com_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "RU_COM_MT";
            bindings = <&moff_tap>, <&ru_com_ques>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        en_com_mt: en_com_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "EN_COM_MT";
            bindings = <&kp>, <&en_com_ques>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        en_dot_mt: en_dot_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "EN_DOT_MT";
            bindings = <&moff_tap>, <&en_dot_excl>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        space_morph: space_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "SPACE_MORPH";
            bindings = <&moff_tap SPACE>, <&moff_tap TAB>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LALT|MOD_LSFT|MOD_RALT|MOD_LCTL|MOD_RGUI|MOD_RCTL|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT|MOD_LALT|MOD_RALT|MOD_LCTL|MOD_RGUI|MOD_LGUI|MOD_RCTL)>;
        };

        caps_soft_sign: caps_soft_sign {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPS_SOFT_SIGN";
            bindings =
                <&moff_kp LS(RU_CYRILLIC_SOFT_SIGN)>,
                <&moff_kp LS(RU_CYRILLIC_HARD_SIGN)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        space_lt: space_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_LT";
            bindings = <&mo>, <&space_morph>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        mod_dtap: mod_dtap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_DTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        hrosm_l: hrosm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HROSM_L";
            bindings = <&moff_kp>, <&moff_kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 30 31 32 33 42 19 7 8 20 9 21 22 10 34 23 41>;
        };

        hrosm_r: hrosm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HROSM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <12 1 13 25 26 27 28 29 17 16 4 5 3 15 2 14>;
        };

        vm_en: vm_en {
            compatible = "zmk,behavior-hold-tap";
            label = "VM_EN";
            bindings = <&vm_lang_en>, <&vm_lang_en>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        vm_ru: vm_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "VM_RU";
            bindings = <&vm_lang_ru>, <&vm_lang_ru>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        back_num: back_num {
            compatible = "zmk,behavior-hold-tap";
            label = "BACK_NUM";
            bindings = <&mo>, <&mouse_back>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        slash_morph_ru: slash_morph_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_MORPH_RU";
            bindings = <&morph_pipe_ru>, <&kp RU_BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        slash_morph_en: slash_morph_en {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_MORPH_EN";
            bindings = <&morph_pipe_en>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        quote_morph_ru: quote_morph_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTE_MORPH_RU";
            bindings = <&morph_quotes_ru>, <&en_kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        quote_morph_en: quote_morph_en {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTE_MORPH_EN";
            bindings = <&morph_quotes_en>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_en_dot: morph_en_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_EN_DOT";
            bindings = <&en_cw_off DOT>, <&en_cw_off EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_en_com: morph_en_com {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_EN_COM";
            bindings = <&en_cw_off COMMA>, <&en_cw_off QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_ru_dot: morph_ru_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_RU_DOT";
            bindings = <&ru_cw_off RU_DOT>, <&ru_cw_off RU_EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_ru_com: morph_ru_com {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_RU_COM";
            bindings = <&ru_cw_off RU_COMMA>, <&ru_cw_off RU_QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_quotes_ru: morph_quotes_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_QUOTES_RU";
            bindings = <&kp RU_DQT>, <&en_kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
        };

        morph_quotes_en: morph_quotes_en {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_QUOTES_EN";
            bindings = <&kp DQT>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
        };

        morph_pipe_ru: morph_pipe_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_PIPE_RU";
            bindings = <&kp RU_SLASH>, <&en_kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        morph_pipe_en: morph_pipe_en {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_PIPE_EN";
            bindings = <&kp SLASH>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
        };

        nav_set: nav_set {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_SET";
            bindings = <&mo>, <&ms_set>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        mdown_morph: mdown_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "MDOWN_MORPH";
            bindings = <&mmvl MOVE_DOWN>, <&moff_kp K>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        mright_morph: mright_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "MRIGHT_MORPH";
            bindings = <&mmvl MOVE_RIGHT>, <&moff_kp L>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        ms_space: ms_space {
            compatible = "zmk,behavior-hold-tap";
            label = "MS_SPACE";
            bindings = <&mo>, <&space_morph>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-while-undecided;
        };

        click_layer: click_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "CLICK_LAYER";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        zero: zero {
            compatible = "zmk,behavior-hold-tap";
            label = "ZERO";
            bindings = <&zeros_macro>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        bspc_lt: bspc_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "BSPC_LT";
            bindings = <&mo>, <&bspc_morph>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        soft: soft {
            compatible = "zmk,behavior-hold-tap";
            label = "SOFT";
            bindings = <&soft_sign>, <&soft_sign>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        soft_caps: soft_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "SOFT_CAPS";
            bindings = <&caps_soft_sign>, <&caps_soft_sign>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mmt: mmt {
            compatible = "zmk,behavior-hold-tap";
            label = "MMT";
            bindings = <&tap>, <&moff_kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
