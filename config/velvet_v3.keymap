    conditional_layers {
        compatible = "zmk,conditional-layers";

        OS {
            if-layers = <2 20>;
            then-layer = <21>;
        };

        Num {
            if-layers = <2 13>;
            then-layer = <14>;
        };

        App {
            if-layers = <2 15>;
            then-layer = <16>;
        };

        Nav {
            if-layers = <2 11>;
            then-layer = <12>;
        };

        Sym_Ru {
            if-layers = <2 17>;
            then-layer = <18>;
        };

        Sym {
            if-layers = <13 11>;
            then-layer = <17>;
        };

        Mouse {
            if-layers = <2 4>;
            then-layer = <5>;
        };

        Mouse_CtrlShift {
            if-layers = <24 25>;
            then-layer = <27>;
        };

        Mouse_CtrlAlt {
            if-layers = <24 26>;
            then-layer = <28>;
        };

        Mouse_ShiftAlt {
            if-layers = <25 26>;
            then-layer = <29>;
        };

        Mouse_MEH {
            if-layers = <24 25 26>;
            then-layer = <30>;
        };
    };
};

&zip_inertia {
    // Initiation delay (Wait time after input stops before starting inertia)
    // Recommended: AT LEAST 2x your sensor's polling interval (e.g., 30ms for 15ms sensor).

    trigger-ms = <3>;

    // --- Mouse Movement Settings ---

    move-decay-factor-int = <80>;       // Decay rate (0-100)
    move-report-interval-ms = <25>;     // Report interval (ms)
    move-threshold-start = <1>;        // Start threshold (pix/report)
    move-threshold-stop = <1>;          // Stop threshold (pix/report)
};

&mmv_input_listener { input-processors = <&zip_inertia>; };

&msc_input_listener {
    faster {
        layers = <23>;
        input-processors = <&zip_scroll_scaler 2 1>;
    };

    slower {
        layers = <22>;
        input-processors = <&zip_scroll_scaler 1 3>;
    };
};

&mmv_input_listener {
    faster {
        layers = <23>;
        input-processors = <&zip_xy_scaler 4 1>, <&zip_inertia>;
    };

    slower {
        layers = <22>;
        input-processors = <&zip_xy_scaler 1 3>, <&zip_inertia>;
    };
};
