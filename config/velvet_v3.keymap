            bindings = <&vm_lang_en>, <&vm_lang_en>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        vm_ru: vm_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "VM_RU";
            bindings = <&vm_lang_ru>, <&vm_lang_ru>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        space_nav_to: space_nav_to {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_NAV_TO";
            bindings = <&mo>, <&space_to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        move_nav: move_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "MOVE_NAV";
            bindings = <&mo>, <&free_move_to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        sticky_drag: sticky_drag {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_DRAG";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <10000>;
            ignore-modifiers;
        };

        mt_mouseoff_ru: mt_mouseoff_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_MOUSEOFF_RU";
            bindings = <&mouseoff_kp_ru>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mt_mouseoff_en: mt_mouseoff_en {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_MOUSEOFF_EN";
            bindings = <&mouseoff_kp_en>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mt_free: mt_free {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_FREE";
            bindings = <&free_kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        l_morph_ru: l_morph_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "L_MORPH_RU";
            bindings = <&kp L>, <&mouseoff_kp_ru LC(L)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        l_morph_en: l_morph_en {
            compatible = "zmk,behavior-mod-morph";
            label = "L_MORPH_EN";
            bindings = <&kp L>, <&mouseoff_kp_en LC(L)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        e_morph_ru: e_morph_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "E_MORPH_RU";
            bindings = <&kp E>, <&mouseoff_kp_ru LC(E)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        e_morph_en: e_morph_en {
            compatible = "zmk,behavior-mod-morph";
            label = "E_MORPH_EN";
            bindings = <&kp E>, <&mouseoff_kp_en LC(E)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        k_morph_ru: k_morph_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "K_MORPH_RU";
            bindings = <&kp K>, <&mouseoff_kp_ru LC(K)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        k_morph_en: k_morph_en {
            compatible = "zmk,behavior-mod-morph";
            label = "K_MORPH_EN";
            bindings = <&kp K>, <&mouseoff_kp_en LC(K)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        slash_morph_ru: slash_morph_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_MORPH_RU";
            bindings = <&morph_pipe_ru>, <&kp RU_BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        slash_morph_en: slash_morph_en {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_MORPH_EN";
            bindings = <&morph_pipe_en>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        quote_morph_ru: quote_morph_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTE_MORPH_RU";
            bindings = <&morph_quotes_ru>, <&en_kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        quote_morph_en: quote_morph_en {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTE_MORPH_EN";
            bindings = <&morph_quotes_en>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mt_sub_ru: mt_sub_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_SUB_RU";
            bindings = <&drag_sub_ru>, <&kp_sub_ru>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mt_sub_en: mt_sub_en {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_SUB_EN";
            bindings = <&drag_sub_en>, <&kp_sub_en>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        morph_en_dot: morph_en_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_EN_DOT";
            bindings = <&en_cw_off DOT>, <&en_cw_off EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_en_com: morph_en_com {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_EN_COM";
            bindings = <&en_cw_off COMMA>, <&en_cw_off QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_ru_dot: morph_ru_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_RU_DOT";
            bindings = <&ru_cw_off RU_DOT>, <&ru_cw_off RU_EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_ru_com: morph_ru_com {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_RU_COM";
            bindings = <&ru_cw_off RU_COMMA>, <&ru_cw_off RU_QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_quotes_ru: morph_quotes_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_QUOTES_RU";
            bindings = <&kp RU_DQT>, <&en_kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        morph_quotes_en: morph_quotes_en {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_QUOTES_EN";
            bindings = <&kp DQT>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        morph_pipe_ru: morph_pipe_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_PIPE_RU";
            bindings = <&kp RU_SLASH>, <&en_kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        morph_pipe_en: morph_pipe_en {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_PIPE_EN";
            bindings = <&kp SLASH>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        En {
            bindings = <
&kp BACKSPACE  &none                  &kp Y                  &kp U                  &mt LC(R) A    &mt LC(T) APOS                             &kp Q     &kp G               &kp N                  &kp W            &kp Z              &none
&kp J          &hrml_slow LEFT_GUI H  &hrml_slow LEFT_ALT I  &hrosm_l LEFT_SHIFT E  &hrml LCTRL O  &en_com_mt LC(F) 0                         &kp M     &hrml_slow RCTRL D  &hrosm_r LEFT_SHIFT R  &hrosm_r RALT S  &hrml_slow RGUI P  &kp K
&kp DELETE     &mt LC(Z) X            &mt LC(X) K_CANCEL     &mt LC(C) K_CANCEL     &mt LC(V) SQT  &en_dot_mt LG(V) 0                         &kp V     &kp C               &kp L                  &kp F            &mt LC(SLASH) B    &none
                                      &kp LS(F7)             &kp F7                 &ms_over_en    &lt 13 SPACE        &sl 17    &bspc_morph  &lt 15 T  &ms_free_en         &kp F2                 &kp LS(F2)
            >;

            display-name = "English";
        };

        En_CW {
            bindings = <
&trans     &none                      &kp LS(Y)                  &kp LS(U)                  &mt LC(R) LS(A)    &mt LC(T) APOS                            &kp LS(Q)     &kp LS(G)               &kp LS(N)                  &kp LS(W)            &kp LS(Z)              &trans
&kp LS(J)  &hrml_slow LEFT_GUI LS(H)  &hrml_slow LEFT_ALT LS(I)  &hrosm_l LEFT_SHIFT LS(E)  &hrml LCTRL LS(O)  &en_com_mt LC(F) 0                        &kp LS(M)     &hrml_slow RCTRL LS(D)  &hrosm_r LEFT_SHIFT LS(R)  &hrosm_r RALT LS(S)  &hrml_slow RGUI LS(P)  &kp LS(K)
&trans     &mt LC(Z) LS(X)            &mt LC(X) K_CANCEL         &mt LC(C) K_CANCEL         &mt LC(V) SQT      &en_dot_mt LG(V) 0                        &kp LS(V)     &kp LS(C)               &kp LS(L)                  &kp LS(F)            &mt LC(SLASH) LS(B)    &trans
                                      &trans                     &trans                     &trans             &en_lt_cw_off 13 SPACE  &trans    &trans  &lt 15 LS(T)  &trans                  &trans                     &trans
            >;

            display-name = "CapsWord_en";
        };

        Ru {
            bindings = <
&trans             &kp RU_CYRILLIC_TSE                      &soft_sign                         &kp RU_CYRILLIC_YA                  &mt LC(R) RU_CYRILLIC_A     &mt LC(T) RU_CYRILLIC_YU                    &kp RU_CYRILLIC_ZE     &kp RU_CYRILLIC_VE               &kp RU_CYRILLIC_KA                  &kp RU_CYRILLIC_DE            &kp RU_CYRILLIC_SHCHA            &trans
&kp RU_CYRILLIC_E  &hrml_slow LEFT_GUI RU_CYRILLIC_SHORT_I  &hrml_slow LEFT_ALT RU_CYRILLIC_I  &hrosm_l LEFT_SHIFT RU_CYRILLIC_IE  &hrml LCTRL RU_CYRILLIC_O   &ru_com_mt LC(F) 0                          &kp RU_CYRILLIC_EL     &hrml_slow RCTRL RU_CYRILLIC_EN  &hrosm_r LEFT_SHIFT RU_CYRILLIC_TE  &hrosm_r RALT RU_CYRILLIC_ES  &hrml_slow RGUI RU_CYRILLIC_CHE  &kp RU_CYRILLIC_SHA
&trans             &mt LC(Z) RU_CYRILLIC_EF                 &mt LC(X) RU_CYRILLIC_U            &mt LC(C) RU_CYRILLIC_HA            &mt LC(V) RU_CYRILLIC_YERU  &ru_dot_mt LG(V) 0                          &kp RU_CYRILLIC_BE     &kp RU_CYRILLIC_EM               &kp RU_CYRILLIC_PE                  &kp RU_CYRILLIC_GHE           &mt LC(SLASH) RU_CYRILLIC_ZHE    &trans
                                                            &trans                             &trans                              &ms_over_ru                 &lt 12 SPACE              &sl 18    &trans  &lt 16 RU_CYRILLIC_ER  &ms_free_ru                      &trans                              &trans
            >;

            display-name = "Russian";
        };

        Ru_CW {
            bindings = <
&trans                 &kp LS(RU_CYRILLIC_TSE)                      &caps_soft_sign                        &kp LS(RU_CYRILLIC_YA)                  &mt LC(R) LS(RU_CYRILLIC_A)     &mt LC(T) LS(RU_CYRILLIC_YU)                    &kp LS(RU_CYRILLIC_ZE)     &kp LS(RU_CYRILLIC_VE)               &kp LS(RU_CYRILLIC_KA)                  &kp LS(RU_CYRILLIC_DE)            &kp LS(RU_CYRILLIC_SHCHA)            &trans
&kp LS(RU_CYRILLIC_E)  &hrml_slow LEFT_GUI LS(RU_CYRILLIC_SHORT_I)  &hrml_slow LEFT_ALT LS(RU_CYRILLIC_I)  &hrosm_l LEFT_SHIFT LS(RU_CYRILLIC_IE)  &hrml LCTRL LS(RU_CYRILLIC_O)   &ru_com_mt LC(F) 0                              &kp LS(RU_CYRILLIC_EL)     &hrml_slow RCTRL LS(RU_CYRILLIC_EN)  &hrosm_r LEFT_SHIFT LS(RU_CYRILLIC_TE)  &hrosm_r RALT LS(RU_CYRILLIC_ES)  &hrml_slow RGUI LS(RU_CYRILLIC_CHE)  &kp LS(RU_CYRILLIC_SHA)
&trans                 &mt LC(Z) LS(RU_CYRILLIC_EF)                 &mt LC(X) LS(RU_CYRILLIC_U)            &mt LC(C) LS(RU_CYRILLIC_HA)            &mt LC(V) LS(RU_CYRILLIC_YERU)  &ru_dot_mt LG(V) 0                              &kp LS(RU_CYRILLIC_BE)     &kp LS(RU_CYRILLIC_EM)               &kp LS(RU_CYRILLIC_PE)                  &kp LS(RU_CYRILLIC_GHE)           &mt LC(SLASH) LS(RU_CYRILLIC_ZHE)    &trans
                                                                    &trans                                 &trans                                  &ms_over_ru                     &ru_lt_cw_off 12 SPACE        &trans    &trans  &lt 16 LS(RU_CYRILLIC_ER)  &ms_free_ru                          &trans                                  &trans
            >;

            display-name = "CapsWord_ru";
        };

        MFree_ru {
            bindings = <
&none  &kp Q             &kp W             &e_morph_ru       &mt_free LC(R) R  &mt_mouseoff_ru LC(T) T                                   &kp Y                  &kp U  &kp I        &kp O        &kp P      &trans
&none  &kp LEFT_GUI      &kp LALT          &kp LSHFT         &kp LCTRL         &mt_mouseoff_ru LC(F) G                                   &kp H                  &kp J  &k_morph_ru  &l_morph_ru  &kp SEMI   &kp SQT
&none  &mt_free LC(Z) Z  &mt_free LC(X) X  &mt_free LC(C) C  &mt_free LC(V) V  &mt_mouseoff_ru LG(V) B                                   &kp N                  &kp M  &kp COMMA    &kp DOT      &kp SLASH  &trans
                         &trans            &trans            &ms_over_ru       &space_lt 12 0           &freeoff_sl 4 18    &bspc_morph  &lt 16 RU_CYRILLIC_ER  &none  &trans       &trans
            >;

            display-name = "MFree_ru";
        };

        M1_ru {
            display-name = "M1_ru";
