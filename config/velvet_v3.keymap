    zip_auto_mouse: zip_auto_mouse {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <500>;
        excluded-positions = <2 3 4 14 15 16 26 27 39>;
    };

    keymap {
        compatible = "zmk,keymap";

        En {
            bindings = <
&none         &mt Q Q                &mt W W           &mt U U             &mmt LC(R) A             &mt LC(T) K_CANCEL                         &mt Z Z   &mt V V        &mt K K                &mt D D          &kp K_CANCEL       &none
&kp K_CANCEL  &hrml_slow LEFT_GUI C  &hrml LEFT_ALT I  &hrml LEFT_SHIFT E  &hrml LCTRL O            &en_com_mt LC(F) 0                         &mt L L   &hrml RCTRL N  &hrosm_r LEFT_SHIFT T  &hrosm_r RALT S  &hrml_slow RGUI H  &kp K_CANCEL
&none         &mmt LC(Z) F           &mmt LC(X) Y      &mmt LC(C) X        &mmt LC(V) SINGLE_QUOTE  &en_dot_mt LG(V) 0                         &mt B B   &mt M M        &mt P P                &mt G G          &mt LC(SLASH) J    &none
                                     &kp LS(F7)        &kp F7              &layer_ru                &lt 10 SPACE        &sl 14    &osm LSHIFT  &lt 12 R  &layer_en      &kp F2                 &kp LS(F2)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        En_CW {
            bindings = <
&trans            &mt LS(Q) LS(Q)            &mt LS(W) LS(W)       &mt LS(U) LS(U)         &mmt LC(R) LS(A)         &mt LC(T) K_CANCEL                        &mt LS(Z) LS(Z)  &mt LS(V) LS(V)    &mt LS(K) LS(K)         &mt LS(D) LS(D)      &kp LS(K_CANCEL)       &trans
&kp LS(K_CANCEL)  &hrml_slow LEFT_GUI LS(C)  &hrml LEFT_ALT LS(I)  &hrml LEFT_SHIFT LS(E)  &hrml LCTRL LS(O)        &en_com_mt LC(F) 0                        &mt LS(L) LS(L)  &hrml RCTRL LS(N)  &hrml LEFT_SHIFT LS(T)  &hrosm_r RALT LS(S)  &hrml_slow RGUI LS(H)  &kp LS(K_CANCEL)
&trans            &mmt LC(Z) LS(F)           &mmt LC(X) LS(Y)      &mmt LC(C) LS(X)        &mmt LC(V) SINGLE_QUOTE  &en_dot_mt LG(V) 0                        &mt LS(B) LS(B)  &mt LS(M) LS(M)    &mt LS(P) LS(P)         &mt LS(G) LS(G)      &mt LC(SLASH) LS(J)    &trans
                                             &trans                &trans                  &trans                   &en_lt_cw_off 10 SPACE  &sl 14    &trans  &lt 12 LS(R)     &trans             &trans                  &trans
            >;
        };

        Ru {
            bindings = <
