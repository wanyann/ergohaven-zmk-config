&mt RU_CYRILLIC_E RU_CYRILLIC_E  &hrml_slow LEFT_GUI RU_CYRILLIC_SHORT_I  &hrml LEFT_ALT RU_CYRILLIC_I  &hrml LEFT_SHIFT RU_CYRILLIC_IE    &hrml LCTRL RU_CYRILLIC_O    &ru_com_mt LC(F) 0                              &mt RU_CYRILLIC_EL RU_CYRILLIC_EL  &hrml RCTRL RU_CYRILLIC_EN         &hrml LEFT_SHIFT RU_CYRILLIC_TE    &hrosm_r RALT RU_CYRILLIC_ES         &hrml_slow RGUI RU_CYRILLIC_CHE          &mt RU_CYRILLIC_SHA RU_CYRILLIC_SHA
&none                            &mmt LC(Z) RU_CYRILLIC_EF                &mmt LC(X) RU_CYRILLIC_U      &mmt LC(C) RU_CYRILLIC_HA          &mmt LC(V) RU_CYRILLIC_YERU  &ru_dot_mt LG(V) 0                              &mt RU_CYRILLIC_BE RU_CYRILLIC_BE  &mt RU_CYRILLIC_EM RU_CYRILLIC_EM  &mt RU_CYRILLIC_PE RU_CYRILLIC_PE  &mt RU_CYRILLIC_GHE RU_CYRILLIC_GHE  &mt LC(SLASH) RU_CYRILLIC_ZHE            &none
                                                                          &trans                        &trans                             &trans                       &lt 10 SPACE              &sl 14    &osm LSHFT  &lt 12 RU_CYRILLIC_ER              &trans                             &trans                             &trans
            >;
